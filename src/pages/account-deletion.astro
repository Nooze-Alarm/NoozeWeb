---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';

// Section list drives both the h2s and the table of contents.
const sections = [
    { id: 'in-app', title: 'Option 1: in the app' },
    { id: 'by-email', title: 'Option 2: by email, without the app' },
    { id: 'deleted', title: 'What is deleted' },
    { id: 'not-deleted', title: 'What is not deleted by us' },
    { id: 'some-data', title: 'Deleting some data without deleting your account', toc: 'Deleting some data only' },
];
const pad = (i) => String(i + 1).padStart(2, '0');
const idx = (id) => sections.findIndex((s) => s.id === id);
const n = (id) => pad(idx(id));
const t = (id) => sections[idx(id)].title;
---
<BaseLayout
    title={"Delete your account | Nooze Alarm"}
    description={"How to delete your Nooze account and data, in the app or by email, and what is deleted."}
    keywords={"delete nooze account, nooze account deletion, nooze delete data, nooze gdpr erasure"}
    canonical={"account-deletion.html"}
>

  <Fragment slot="head">
    <script type="application/ld+json" set:html={"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://noozealarm.com/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Delete your account\",\"item\":\"https://noozealarm.com/account-deletion.html\"}]}"} />
  </Fragment>

<main id="main" class="flex-1">
    <PageHeader
        compact
        title="Delete your account"
        lede="Remove your account and everything stored with it, in the app or by email."
    >
        <dl class="legal-meta">
            <div><dt>In the app</dt><dd>Deleted immediately</dd></div>
            <div><dt>By email</dt><dd>Within 30 days</dd></div>
            <div><dt>Contact</dt><dd><a class="nz-link" href="mailto:noozealarm@gmail.com">noozealarm@gmail.com</a></dd></div>
        </dl>
    </PageHeader>

    <div class="nz-container legal">
        <aside class="legal-aside">
            <nav class="legal-toc" aria-label="Contents" data-spy>
                <p class="nz-meta legal-toc-label">Contents</p>
                <ol>
                    {sections.map((s, i) => (
                        <li><a href={`#${s.id}`}><span class="legal-toc-n">{pad(i)}</span><span>{s.toc ?? s.title}</span></a></li>
                    ))}
                </ol>
            </nav>
        </aside>

        <details class="legal-toc-m">
            <summary><span>Contents</span><span class="legal-toc-m-count">{sections.length} sections</span><span class="legal-toc-m-icon" aria-hidden="true"></span></summary>
            <nav aria-label="Contents">
                <ol>
                    {sections.map((s, i) => (
                        <li><a href={`#${s.id}`}><span class="legal-toc-n">{pad(i)}</span><span>{s.toc ?? s.title}</span></a></li>
                    ))}
                </ol>
            </nav>
        </details>

        <article class="nz-prose legal-body" id="account-deletion">
            <p class="legal-intro">This page explains how to delete your account and data for the Android app “Nooze Sleep Tracker &amp; Alarm” by Nooze.</p>

            <div class="del-options">
                <section class="legal-sec del-opt" id="in-app">
                    <h2><span class="sec-n">{n('in-app')}</span>{t('in-app')}</h2>
                    <ol class="del-steps">
                        <li>Open Nooze and go to the <strong>Profile</strong> tab.</li>
                        <li>Scroll to the bottom and tap <strong>Delete Account</strong>.</li>
                        <li>Confirm.</li>
                    </ol>
                    <p class="del-result">Your account and cloud data are deleted immediately.</p>
                </section>

                <section class="legal-sec del-opt" id="by-email">
                    <h2><span class="sec-n">{n('by-email')}</span>{t('by-email')}</h2>
                    <ol class="del-steps">
                        <li>Send an email to <a href="mailto:noozealarm@gmail.com?subject=Delete%20my%20Nooze%20account">noozealarm@gmail.com</a> with the subject “Delete my Nooze account”.</li>
                        <li>Send it from the email address your Nooze account uses, so we can confirm the account is yours.</li>
                    </ol>
                    <p class="del-result">We delete the account within 30 days and reply to confirm.</p>
                </section>
            </div>

            <section class="legal-sec" id="deleted">
                <h2><span class="sec-n">{n('deleted')}</span>{t('deleted')}</h2>
                <ul>
                    <li>Your account: email address, display name, username and avatar</li>
                    <li>Your profile choices, level, XP, streaks, achievements and quest completions</li>
                    <li>Your friendships, friend requests, wake duels and activity feed entries</li>
                    <li>Your leaderboard entries</li>
                    <li>Your journal entry dates</li>
                    <li>Your subscription record in our database</li>
                    <li>Your wake-up buddy links, missed wake-up check records and notification tokens</li>
                    <li>Squads you own; you are removed from other squads</li>
                </ul>
            </section>

            <section class="legal-sec" id="not-deleted">
                <h2><span class="sec-n">{n('not-deleted')}</span>{t('not-deleted')}</h2>
                <ul class="defs">
                    <li><strong>Data on your phone.</strong> Sleep sessions, recordings, alarms and journal text are stored only on your device. Deleting your account in the app clears them; if you delete by email, clear the app’s storage in Android settings or uninstall the app.</li>
                    <li><strong>Your Google Play subscription.</strong> Deleting your account does not cancel a subscription. Cancel it in Google Play under Payments and subscriptions. Google keeps its own purchase records under its policies.</li>
                    <li><strong>Analytics and crash data</strong> held by Firebase is not linked to your account and expires within 14 months.</li>
                </ul>
            </section>

            <section class="legal-sec" id="some-data">
                <h2><span class="sec-n">{n('some-data')}</span>{t('some-data')}</h2>
                <p>Sleep sessions, recordings and journal entries exist only on your device and can be removed there. To have other data removed while keeping your account, email us at the address above.</p>
                <p>See also the <a href="privacy.html">privacy policy</a>.</p>
            </section>
        </article>
    </div>
</main>
</BaseLayout>

<script>
    // Table of contents: highlight the section under the reading line; close the mobile list after a jump.
    const toc = document.querySelector('[data-spy]');
    if (toc && 'IntersectionObserver' in window) {
        const links = new Map();
        toc.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((a) => {
            const sec = document.getElementById(a.hash.slice(1));
            if (sec) links.set(sec, a);
        });
        const io = new IntersectionObserver((entries) => {
            entries.forEach((e) => {
                if (!e.isIntersecting) return;
                links.forEach((a) => a.removeAttribute('aria-current'));
                links.get(e.target)?.setAttribute('aria-current', 'true');
            });
        }, { rootMargin: '-20% 0px -75% 0px' });
        links.forEach((_, sec) => io.observe(sec));
    }
    const mobile = document.querySelector<HTMLDetailsElement>('.legal-toc-m');
    mobile?.addEventListener('click', (e) => {
        if ((e.target as Element).closest('a')) mobile.open = false;
    });
</script>

<style>
    /* ---- Legal document layout (same as privacy.astro and terms.astro) ---- */

    .legal-meta { display: flex; flex-wrap: wrap; gap: 18px 48px; margin: 44px 0 0; }
    .legal-meta div { display: grid; gap: 8px; }
    .legal-meta dt { font-family: var(--font-mono); font-size: 11px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--fg-3); }
    .legal-meta dd { margin: 0; font-family: var(--font-mono); font-size: 13px; color: var(--fg-2); }

    .legal {
        display: grid; grid-template-columns: 252px minmax(0, 1fr);
        gap: clamp(48px, 7vw, 112px); align-items: start;
        padding-block: clamp(56px, 7vw, 104px) var(--section);
    }
    .legal-aside { position: sticky; top: calc(var(--nav-h) + 32px); }
    .legal-toc { max-height: calc(100vh - var(--nav-h) - 64px); overflow-y: auto; overscroll-behavior: contain; scrollbar-width: thin; }
    .legal-toc-label { margin: 0 0 14px; }
    .legal-toc ol, .legal-toc-m ol { list-style: none; margin: 0; padding: 0; }
    .legal-toc ol { border-left: 1px solid var(--line); }
    .legal-toc a, .legal-toc-m a {
        position: relative;
        display: grid; grid-template-columns: 30px minmax(0, 1fr); align-items: baseline; gap: 6px;
        min-height: 40px; padding: 9px 0 9px 18px;
        font-size: 14.5px; line-height: 1.4; color: var(--fg-3);
        transition: color 0.25s var(--ease-out);
    }
    .legal-toc a::before {
        content: ''; position: absolute; left: -1px; top: 8px; bottom: 8px; width: 2px; border-radius: 1px;
        background: var(--red); transform: scaleY(0); transition: transform 0.4s var(--ease-out);
    }
    .legal-toc a:hover, .legal-toc-m a:hover { color: var(--fg); }
    .legal-toc a[aria-current] { color: var(--fg); }
    .legal-toc a[aria-current]::before { transform: scaleY(1); }
    .legal-toc-n { font-family: var(--font-mono); font-size: 11.5px; color: var(--fg-3); font-variant-numeric: tabular-nums; }
    .legal-toc a[aria-current] .legal-toc-n { color: var(--red); }

    .legal-toc-m { display: none; border-block: 1px solid var(--line-2); }
    .legal-toc-m summary {
        display: flex; align-items: center; gap: 14px; min-height: 56px;
        list-style: none; cursor: pointer; color: var(--fg); font-weight: 600;
    }
    .legal-toc-m summary::-webkit-details-marker { display: none; }
    .legal-toc-m-count { margin-left: auto; font-family: var(--font-mono); font-size: 12px; font-weight: 400; color: var(--fg-3); }
    .legal-toc-m-icon { position: relative; width: 28px; height: 28px; border-radius: 999px; box-shadow: inset 0 0 0 1px var(--line-2); transition: transform 0.5s var(--ease-spring); }
    .legal-toc-m-icon::before, .legal-toc-m-icon::after { content: ''; position: absolute; left: 50%; top: 50%; width: 10px; height: 1.5px; margin: -0.75px 0 0 -5px; background: var(--fg-2); border-radius: 1px; }
    .legal-toc-m-icon::after { transform: rotate(90deg); }
    .legal-toc-m[open] .legal-toc-m-icon { transform: rotate(45deg); }
    .legal-toc-m nav { padding-bottom: 12px; }
    .legal-toc-m a { padding-left: 0; min-height: 44px; }

    .legal-body { max-width: 70ch; }
    .legal-body > :first-child { margin-top: 0; }
    .legal-intro { font-size: 18.5px; line-height: 1.6; color: var(--fg); }
    .legal-sec { scroll-margin-top: calc(var(--nav-h) + 16px); }
    .legal-sec > * + * { margin-top: 1.1em; }
    .legal-sec h2 + * { margin-top: 0.8em; }
    .sec-n { display: block; margin-bottom: 12px; font-family: var(--font-mono); font-size: 12px; font-weight: 500; letter-spacing: 0.06em; color: var(--fg-3); font-variant-numeric: tabular-nums; }
    .legal-body a { overflow-wrap: anywhere; }
    .defs > li + li { margin-top: 0.9em; }

    /* The two ways to delete: side by side trays */
    .del-options { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; margin-top: 2.2em; }
    .del-opt {
        display: flex; flex-direction: column;
        padding: 28px 28px 26px; border-radius: var(--r-lg);
        background: linear-gradient(180deg, var(--ink-2), var(--ink-1));
        box-shadow: inset 0 0 0 1px var(--line-2), inset 0 1px 0 rgba(255, 255, 255, 0.05);
    }
    .nz-prose .del-opt h2 { margin-top: 0; padding-top: 0; border-top: 0; font-size: clamp(21px, 1.8vw, 24px); }
    .del-opt .sec-n { display: none; }
    .del-steps { counter-reset: step; list-style: none; padding-left: 0; }
    .nz-prose .del-steps > li { position: relative; padding-left: 40px; counter-increment: step; }
    .del-steps > li::before {
        content: counter(step, decimal-leading-zero);
        position: absolute; left: 0; top: 0.15em;
        font-family: var(--font-mono); font-size: 12px; color: var(--fg-3); font-variant-numeric: tabular-nums;
    }
    .nz-prose .del-steps > li + li { margin-top: 0.7em; }
    /* Steps grow so both result lines sit on the same baseline */
    .del-opt .del-steps { flex: 1; }
    .del-opt .del-steps + .del-result {
        margin-top: 22px; padding-top: 18px;
        border-top: 1px solid var(--line); font-size: 15px; color: var(--fg);
    }

    @media (max-width: 1023px) {
        .legal { grid-template-columns: minmax(0, 1fr); gap: 40px; padding-top: 40px; }
        .legal-aside { display: none; }
        .legal-toc-m { display: block; }
    }
    @media (max-width: 680px) {
        .del-options { grid-template-columns: minmax(0, 1fr); }
    }
    @media (max-width: 520px) {
        .legal-meta { gap: 16px 32px; }
        .legal-body { font-size: 16.5px; }
        .legal-intro { font-size: 17.5px; }
        .del-opt { padding: 22px 20px; }
    }
</style>
