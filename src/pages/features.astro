---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ClosingCta from '../components/ClosingCta.astro';
import WakeWindowDiagram from '../components/WakeWindowDiagram.astro';

const chapters = [
    { id: 'challenges', n: '01', label: 'No-snooze alarms and challenges' },
    { id: 'your-week', n: '02', label: 'Alarms that fit your week' },
    { id: 'smart-wake', n: '03', label: 'Smart wake and Sunrise Wake' },
    { id: 'sleep', n: '04', label: 'Sleep tracking, estimated' },
    { id: 'accountable', n: '05', label: 'Staying accountable' },
    { id: 'more', n: '06', label: 'Naps, watch and the rest' },
];

const challengeGroups = [
    {
        title: 'Wake your head',
        items: [
            { name: 'Math', desc: 'Solve a few sums before it goes quiet.' },
            { name: 'Memory', desc: 'Watch a sequence, then repeat it back.' },
            { name: 'Typing', desc: 'Type a short phrase exactly as shown.' },
            { name: 'Read aloud', desc: 'Say the sentence on screen out loud.', note: 'On supported phones' },
        ],
    },
    {
        title: 'Get your body going',
        items: [
            { name: 'Shake', desc: 'Shake the phone until you hit the target.' },
            { name: 'Steps', desc: 'Walk a set number of steps.' },
        ],
    },
    {
        title: 'Get out of bed',
        items: [
            { name: 'QR or barcode', desc: 'Scan a code you keep in another room, like a cereal box in the kitchen.' },
            { name: 'NFC tag', desc: 'Tap the phone on a tag stuck somewhere across the room.' },
            { name: 'Photo task', desc: 'Get up and take the photo the task asks for.' },
        ],
        fallback: true,
    },
];

const week = [
    { t: 'Skip just the next one', b: 'Day off tomorrow? Skip the next ring and leave the rest of the schedule alone.' },
    { t: 'Vacation pause', b: 'Pause alarms while you are away, without deleting or rebuilding anything.' },
    { t: 'Public holidays', b: 'Skip the public holidays found in your phone’s calendar.' },
    { t: 'Early starts', b: 'On days that begin with an early event, the alarm can ring earlier.' },
    { t: 'A sound for each day', b: 'Give every day its own alarm sound, so Saturday never sounds like Monday.' },
    { t: 'Home time zone', b: 'Travelling? Keep your alarms on home time.' },
    { t: 'Other apps and your voice', b: 'Other apps and your voice assistant can set alarms and naps in Nooze.' },
];

const readouts = [
    { t: 'Sleep duration', b: 'How long you slept, night by night.' },
    { t: 'Estimated sleep phases', b: 'Lighter and deeper stretches across the night.' },
    { t: 'Approximate sleep score', b: 'One number per night, to compare with other nights.' },
    { t: 'Snoring and noise events', b: 'Moments the microphone picked up sound, if you turned it on.' },
    { t: 'Weekly trends', b: 'Duration and bedtime consistency across the week.' },
    { t: 'Advanced sleep analytics', b: 'More detail for people who like to dig in.', premium: true },
];

const circles = [
    { n: 1, who: 'Just you', t: 'XP and achievements', b: 'Earn XP and unlock achievements for getting up on time. Tick off a morning routine checklist for extra XP.' },
    { n: 2, who: 'You and one friend', t: 'Duels and buddies', b: 'In a wake duel, whoever gets up on time more often wins. A wake-up buddy gets one nudge if you miss your wake-up check.' },
    { n: 4, who: 'Up to four', t: 'Squads', b: 'Team up in a squad of up to four and keep one shared streak alive.' },
    { n: 9, who: 'All your friends', t: 'Leaderboards', b: 'Add friends and climb leaderboards for XP, streaks and achievements.' },
];

const extras = [
    { t: 'Naps', b: 'One tap starts a 20, 30 or 45-minute nap.' },
    { t: 'Widgets and lock screen', b: 'Home-screen widgets, plus a live countdown on the lock screen.' },
    { t: 'Wear OS', b: 'A watch companion with a next-alarm tile. Alarms can ring on your wrist.' },
    { t: 'Sleep sounds', b: 'Sounds to fall asleep to. The full library comes with Premium.' },
    { t: 'Breathing exercise', b: 'Wind down before bed with 4-7-8, box or coherent breathing.' },
    { t: 'Morning journal', b: 'Note how you slept and how you feel while it is still fresh.' },
    { t: 'Themes', b: 'Six free themes. Premium adds six more, with animated backgrounds.' },
    { t: 'No ads', b: 'None on the free plan, none on Premium.' },
    { t: 'Smart home', b: 'Switch on lights or run a scene at wake-up through Home Assistant, Tuya, Tellur or any webhook.', premium: true },
    { t: 'Morning briefing', b: 'A spoken rundown of the weather, your next alarm and the first event of the day.', premium: true },
];

// Built-in column checked against Google Clock and Samsung Clock, November 2026.
const compare = [
    { f: 'Snooze button', n: 'None', t: 'Yes' },
    { f: 'Switching it off', n: 'Finish one of nine challenges', t: 'Tap or swipe' },
    { f: 'If you fall back asleep', n: 'The wake-up check brings the alarm back', t: 'Nothing happens' },
    { f: 'Smart wake window', n: '15, 20 or 30 minutes', t: 'No, only on some smartwatches' },
    { f: 'Skip public holidays automatically', n: 'Yes, from your phone calendar', t: 'Samsung only, in a few countries' },
    { f: 'Sleep tracking', n: 'Estimated, phone or Health Connect', t: 'Basic, or a separate app' },
    { f: 'Streaks, friends and wake duels', n: 'Yes', t: 'No' },
];

const arrow = '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 8h11M9 3.5 13.5 8 9 12.5" /></svg>';
---
<BaseLayout
    title={"Features: no-snooze alarm, wake-up challenges and smart wake | Nooze Alarm"}
    description={"Every Nooze feature: no-snooze alarms with nine wake-up challenges, a smart wake window, estimated sleep tracking, wake duels, naps, widgets and Wear OS."}
    keywords={"no snooze alarm, alarm clock with challenges, wake up challenges, smart wake window, sleep tracker android, nfc alarm, qr code alarm, math alarm, wake duels, alarm app features"}
    canonical={"features.html"}
    ogTitle={"Nooze features: no-snooze alarms, wake-up challenges and smart wake"}
    ogDescription={"Nine wake-up challenges, a smart wake window, estimated sleep tracking, wake duels and more. Free on Google Play."}
    active={"features"}
>

  <Fragment slot="head">
    <script type="application/ld+json" set:html={"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://noozealarm.com/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Features\",\"item\":\"https://noozealarm.com/features.html\"}]}"} />
  </Fragment>

<main id="main" class="flex-1">
    <PageHeader
        title="Everything Nooze does, except snooze."
        lede="Nine wake-up challenges, alarms that fit your week, a smart wake window and friends who keep you honest. Premium extras are marked."
    >
        <nav class="fx-index" aria-label="On this page">
            <ol>
                {chapters.map((c) => (
                    <li><a href={`#${c.id}`}><span class="fx-index-n">{c.n}</span><span class="fx-index-l">{c.label}</span></a></li>
                ))}
            </ol>
        </nav>
    </PageHeader>

    <!-- 01: No snooze + the nine challenges -->
    <section id="challenges" class="nz-section" aria-labelledby="ch1">
        <div class="nz-container">
            <div class="fx-intro">
                <div class="fx-head nz-reveal">
                    <p class="fx-num">01</p>
                    <h2 id="ch1" class="nz-h2 fx-title">No snooze. Nine ways to prove you are up.</h2>
                    <p class="nz-lede">To switch an alarm off, you finish a wake-up challenge. Pick the challenge and how hard it is for each alarm.</p>
                </div>
                <div class="fx-pair" data-stagger>
                    <figure class="fx-shot nz-reveal">
                        <img src="/assets/screens/02-challenges.webp" srcset="/assets/screens/02-challenges-400.webp 400w, /assets/screens/02-challenges.webp 640w" sizes="(max-width: 640px) 46vw, 240px" width="640" height="1093" loading="lazy" decoding="async" alt="The Nooze add-alarm screen: Sunrise wake and Smart Wake switches, then a wake-up challenge picker with math, memory, shake, typing, QR scan and photo." />
                        <figcaption>Pick a challenge</figcaption>
                    </figure>
                    <figure class="fx-shot nz-reveal">
                        <img src="/assets/screens/01-challenge.webp" srcset="/assets/screens/01-challenge-400.webp 400w, /assets/screens/01-challenge.webp 640w" sizes="(max-width: 640px) 46vw, 240px" width="640" height="1093" loading="lazy" decoding="async" alt="A math wake-up challenge in Nooze, problem 1 of 3: 12 + 37, with an answer field and a submit button." />
                        <figcaption>Solve it to switch off</figcaption>
                    </figure>
                </div>
            </div>

            <div class="fx-chal" data-stagger>
                {challengeGroups.map((g) => (
                    <div class="fx-chal-group nz-reveal">
                        <div class="fx-chal-gh">
                            <h3 class="fx-chal-gt">{g.title}</h3>
                            <span class="nz-meta">{g.items.length} {g.items.length === 1 ? 'challenge' : 'challenges'}</span>
                        </div>
                        <dl class="fx-chal-list">
                            {g.items.map((c) => (
                                <div class="fx-chal-item">
                                    <dt class="fx-chal-name">{c.name}</dt>
                                    <dd class="fx-chal-desc">{c.desc}{c.note && <span class="fx-chal-note">{c.note}</span>}</dd>
                                </div>
                            ))}
                        </dl>
                        {g.fallback && (
                            <p class="fx-fallback">
                                <span class="fx-fallback-t nz-mono" aria-hidden="true">2:00</span>
                                <span>Tag missing? After two minutes, scan, NFC and photo challenges offer a math problem instead, so you are never stuck.</span>
                            </p>
                        )}
                    </div>
                ))}
            </div>

            <div class="fx-after">
                <div class="nz-reveal">
                    <h3 class="nz-h3">Easy, medium or hard</h3>
                    <p class="fx-p">Set the difficulty per alarm. Easy for gentle weekdays, hard for the mornings you know you will fight it.</p>
                    <div class="nz-tags fx-diff">
                        <span class="nz-tag">Easy</span><span class="nz-tag">Medium</span><span class="nz-tag">Hard</span>
                    </div>
                </div>
                <div class="nz-reveal" style="--d:1">
                    <h3 class="nz-h3">Then, the wake-up check</h3>
                    <p class="fx-p">Turn it on and Nooze makes sure you stayed up. Ignore it and the alarm comes back.</p>
                    <ol class="fx-seq">
                        <li><b>Alarm rings</b><span>No snooze button on the screen.</span></li>
                        <li><b>Challenge done</b><span>The alarm goes quiet.</span></li>
                        <li><b>Still up?</b><span>A few minutes later, Nooze asks.</span></li>
                        <li><b>No answer</b><span>The alarm rings again.</span></li>
                    </ol>
                </div>
            </div>
        </div>
    </section>

    <!-- 02: Alarms that fit your week -->
    <section id="your-week" class="nz-section fx-ch" aria-labelledby="ch2">
        <div class="nz-container nz-split">
            <div class="nz-split-head fx-head nz-reveal">
                <p class="fx-num">02</p>
                <h2 id="ch2" class="nz-h2 fx-title">Alarms that fit your week.</h2>
                <p class="nz-lede">Real weeks have holidays, early meetings and trips. Nooze plans around them, so you are not editing alarms at midnight.</p>
                <p class="fx-aside">Unlimited alarms, all on the free plan.</p>
            </div>
            <ul class="nz-rows fx-week" data-stagger>
                {week.map((r) => (
                    <li class="nz-row nz-reveal">
                        <h3 class="nz-row-title">{r.t}</h3>
                        <p class="nz-row-body">{r.b}</p>
                    </li>
                ))}
            </ul>
        </div>
    </section>

    <!-- 03: Smart wake + Sunrise Wake -->
    <section id="smart-wake" class="nz-section nz-band" aria-labelledby="ch3">
        <div class="nz-container">
            <div class="fx-head nz-reveal">
                <p class="fx-num">03</p>
                <h2 id="ch3" class="nz-h2 fx-title">A window, not a single minute.</h2>
                <p class="nz-lede">Set a 15, 20 or 30-minute window before your alarm. Nooze picks an estimated lighter moment of sleep inside it to ring.</p>
            </div>

            <WakeWindowDiagram sunNote={false} />

            <div class="fx-twocol" data-stagger>
                <div class="nz-reveal">
                    <h3 class="nz-h3">How it picks the moment</h3>
                    <p class="fx-p">Nooze estimates how light your sleep is from your phone’s motion sensor and optional microphone, or from a band or watch through Health Connect. The window ends at your alarm time.</p>
                </div>
                <div class="nz-reveal">
                    <h3 class="nz-h3">Sunrise Wake</h3>
                    <p class="fx-p">Your wake-up screen starts dark and warms into a soft glow, like a small sunrise on the nightstand. Kind to dark winter mornings.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- 04: Sleep tracking, estimated -->
    <section id="sleep" class="nz-section" aria-labelledby="ch4">
        <div class="nz-container nz-split">
            <div class="nz-split-head fx-head nz-reveal">
                <p class="fx-num">04</p>
                <h2 id="ch4" class="nz-h2 fx-title">Your night, estimated.</h2>
                <p class="nz-lede">Track with your phone, or with a band or watch through Health Connect. Every number is an estimate, and labelled as one.</p>
                <figure class="fx-shot fx-shot--head">
                    <img src="/assets/screens/05-sleep.webp" srcset="/assets/screens/05-sleep-400.webp 400w, /assets/screens/05-sleep.webp 640w" sizes="(max-width: 640px) 62vw, 240px" width="640" height="1093" loading="lazy" decoding="async" alt="The Nooze sleep screen: a bedtime reminder, a sleep tip, tiles for sleep aids, journal, sleep analytics and recordings, and a note that Nooze is not a medical device." />
                    <figcaption>The sleep tab</figcaption>
                </figure>
            </div>

            <div class="fx-stack">
                <div class="fx-src nz-reveal">
                    <div>
                        <h3 class="fx-sub">Your phone</h3>
                        <p class="fx-p">The motion sensor, plus the microphone if you allow it. No extra hardware.</p>
                    </div>
                    <span class="fx-src-or" aria-hidden="true">or</span>
                    <div>
                        <h3 class="fx-sub">Health Connect</h3>
                        <p class="fx-p">Sleep and heart-rate data from a compatible band or watch.</p>
                    </div>
                </div>

                <div class="nz-reveal">
                    <h3 class="fx-sub fx-sub--gap">What you see each morning</h3>
                    <dl class="fx-grid">
                        {readouts.map((r) => (
                            <div>
                                <dt>{r.t}{r.premium && <span class="nz-tag nz-tag--red fx-prem">Premium</span>}</dt>
                                <dd>{r.b}</dd>
                            </div>
                        ))}
                    </dl>
                </div>

                <div class="nz-reveal">
                    <h3 class="fx-sub fx-sub--gap">Two modes for real bedrooms</h3>
                    <dl class="fx-grid">
                        <div>
                            <dt>Shared bed</dt>
                            <dd>Tuned so a partner’s tossing and turning is less likely to count as yours.</dd>
                        </div>
                        <div>
                            <dt>Wearable only</dt>
                            <dd>Leave the phone sensors out and use your band or watch data alone.</dd>
                        </div>
                    </dl>
                </div>

                <div class="fx-notes nz-reveal">
                    <div>
                        <p class="fx-notes-t">Stays on your phone</p>
                        <p>Sensor, microphone and Health Connect data stay on the device. No ads, no data sales.</p>
                    </div>
                    <div>
                        <p class="fx-notes-t">For general wellness</p>
                        <p>Nooze is not a medical device. Phases, scores and noise events are estimates to help you spot patterns, not medical advice.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 05: Stay accountable -->
    <section id="accountable" class="nz-section fx-ch" aria-labelledby="ch5">
        <div class="nz-container">
            <div class="fx-head nz-reveal">
                <p class="fx-num">05</p>
                <h2 id="ch5" class="nz-h2 fx-title">Friends make it harder to sleep in.</h2>
                <p class="nz-lede">Earn XP for getting up on time. Then bring in a friend, a buddy or a squad, and sleeping in stops being private.</p>
            </div>

            <ol class="fx-circle" data-stagger>
                {circles.map((c) => (
                    <li class="nz-reveal">
                        <svg class="fx-people" viewBox={`0 0 ${c.n * 18} 16`} width={c.n * 18} height="16" aria-hidden="true">
                            {Array.from({ length: c.n }, (_, i) => (
                                i === 0
                                    ? <circle cx="8" cy="8" r="6" fill="var(--red)" />
                                    : <circle cx={8 + i * 18} cy="8" r="5.25" fill="none" stroke="currentColor" stroke-width="1.5" opacity={c.n > 4 ? Math.max(0.25, 1 - (i - 1) * 0.1) : 1} />
                            ))}
                        </svg>
                        <p class="fx-circle-k">{c.who}</p>
                        <h3 class="nz-h3">{c.t}</h3>
                        <p class="fx-p">{c.b}</p>
                    </li>
                ))}
            </ol>
        </div>
    </section>

    <!-- 06: Naps, watch, sounds and the rest -->
    <section id="more" class="nz-section fx-ch" aria-labelledby="ch6">
        <div class="nz-container nz-split">
            <div class="nz-split-head fx-head nz-reveal">
                <p class="fx-num">06</p>
                <h2 id="ch6" class="nz-h2 fx-title">Naps, watches, sounds and the rest.</h2>
                <p class="nz-lede">The extras around the alarm itself, from bedtime to the first coffee.</p>
                <p class="fx-aside">Premium is €1.99 a month or €13.99 a year, about 41% less than monthly. Cancel any time in Google Play.</p>
            </div>
            <dl class="fx-grid fx-grid--more" data-stagger>
                {extras.map((x) => (
                    <div class="nz-reveal">
                        <dt>{x.t}{x.premium && <span class="nz-tag nz-tag--red fx-prem">Premium</span>}</dt>
                        <dd>{x.b}</dd>
                    </div>
                ))}
            </dl>
        </div>
    </section>

    <!-- Comparison -->
    <section id="compare" class="nz-section nz-band" aria-labelledby="cmpTitle">
        <div class="nz-container">
            <div class="fx-head nz-reveal">
                <h2 id="cmpTitle" class="nz-h2 fx-title">Nooze next to your phone’s clock.</h2>
                <p class="nz-lede">A fair look against the clock app your phone came with.</p>
            </div>
            <div class="fx-cmp-wrap nz-reveal" role="region" aria-labelledby="cmpTitle" tabindex="0">
                <table class="fx-cmp">
                    <colgroup><col class="fx-cmp-c1" /><col /><col /></colgroup>
                    <thead>
                        <tr>
                            <th scope="col"><span class="sr-only">Feature</span></th>
                            <th scope="col" class="is-nooze">Nooze</th>
                            <th scope="col">Built-in clock app</th>
                        </tr>
                    </thead>
                    <tbody>
                        {compare.map((r) => (
                            <tr>
                                <th scope="row">{r.f}</th>
                                <td class="is-nooze">{r.n}</td>
                                <td>{r.t}</td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
            <p class="fx-cmp-note nz-reveal">Checked against Google Clock and Samsung Clock in November 2026. Some other alarm apps cover a few of these too.</p>
        </div>
    </section>

    <ClosingCta secondary={{ href: '/faq.html', label: 'Read the FAQ' }} />
</main>
</BaseLayout>

<style>
    /* ---------- In-page index (inside the page header) ---------- */
    .fx-index { margin-top: clamp(48px, 6vw, 88px); }
    .fx-index ol {
        list-style: none; margin: 0; padding: 0;
        display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); column-gap: 20px;
    }
    .fx-index li { border-top: 1px solid var(--line-2); min-width: 0; }
    .fx-index a {
        position: relative; display: flex; flex-direction: column; gap: 10px;
        min-height: 44px; padding: 18px 8px 8px 0;
        font-size: 15px; line-height: 1.35; color: var(--fg-2);
        transition: color 0.25s var(--ease-out);
    }
    .fx-index a::before {
        content: ''; position: absolute; left: 0; right: 0; top: -1px; height: 1px; background: var(--fg);
        transform: scaleX(0); transform-origin: left; transition: transform 0.55s var(--ease-out);
    }
    .fx-index a:hover { color: var(--fg); }
    .fx-index a:hover::before { transform: scaleX(1); }
    .fx-index-n { font-family: var(--font-mono); font-size: 12px; color: var(--fg-3); font-variant-numeric: tabular-nums; transition: color 0.25s var(--ease-out); }
    .fx-index a:hover .fx-index-n { color: var(--red); }
    @media (max-width: 1000px) { .fx-index ol { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
    @media (max-width: 560px) {
        .fx-index ol { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 16px; }
        .fx-index a { padding: 14px 4px 14px 0; font-size: 14.5px; gap: 6px; }
    }

    /* ---------- Chapter scaffolding ---------- */
    .fx-ch { border-top: 1px solid var(--line); }
    .fx-num {
        display: flex; align-items: center; gap: 14px; margin: 0 0 26px;
        font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.06em; color: var(--fg-3);
        font-variant-numeric: tabular-nums;
    }
    .fx-num::after { content: ''; width: 44px; height: 1px; background: var(--line-3); }
    .fx-head { max-width: 780px; }
    .fx-title { font-size: clamp(34px, 4vw, 58px); line-height: 1.02; }
    .fx-head .nz-lede { margin-top: 24px; }
    .fx-aside { margin: 28px 0 0; font-size: 14.5px; line-height: 1.55; color: var(--fg-2); max-width: 38ch; }
    .fx-p { margin: 12px 0 0; color: var(--fg-2); font-size: 16px; line-height: 1.6; max-width: 56ch; }

    /* Real app screenshots: bare, hairline-edged, no device frame */
    .fx-shot { margin: 0; }
    .fx-shot img {
        display: block; width: 100%; height: auto; border-radius: 20px; background: var(--ink-2);
        box-shadow: 0 0 0 1px var(--line-2), 0 40px 80px -40px rgba(0, 0, 0, 0.9);
    }
    .fx-shot figcaption { margin-top: 14px; font-family: var(--font-mono); font-size: 12px; color: var(--fg-3); }
    .fx-intro { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 56px clamp(40px, 6vw, 96px); align-items: end; }
    .fx-pair { display: grid; grid-template-columns: repeat(2, 220px); gap: 20px; align-items: start; }
    .fx-pair .fx-shot:nth-child(2) { margin-top: 56px; }
    /* Sized so the sticky head still fits a laptop viewport */
    .fx-shot--head { width: clamp(150px, calc((100svh - 440px) / 1.708), 240px); margin-top: 44px; }
    @media (max-width: 900px) {
        .fx-intro { grid-template-columns: minmax(0, 1fr); }
        .fx-pair { grid-template-columns: repeat(2, minmax(0, 220px)); gap: 14px; }
        .fx-pair .fx-shot:nth-child(2) { margin-top: 36px; }
        .fx-shot--head { width: min(240px, 62%); margin-top: 36px; }
    }

    /* ---------- 02: week rows (title and body, no index column) ---------- */
    .fx-week .nz-row { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
    @media (max-width: 760px) {
        .fx-week .nz-row { grid-template-columns: minmax(0, 1fr); }
        .fx-week .nz-row-body { grid-column: auto; }
    }

    /* ---------- 01: challenge board ---------- */
    .fx-chal {
        margin-top: clamp(56px, 7vw, 96px);
        display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 48px clamp(24px, 3.5vw, 56px);
