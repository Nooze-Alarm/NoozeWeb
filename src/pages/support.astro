---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { launch } from '../data/launch';

const KOFI = 'https://ko-fi.com/noozealarm';
const kofiPath = 'M23.881 8.948c-.773-4.085-4.859-4.593-4.859-4.593H.723c-.604 0-.679.798-.679.798s-.082 7.324-.022 11.822c.164 2.424 2.586 2.672 2.586 2.672s8.267-.023 11.966-.049c2.438-.426 2.683-2.566 2.658-3.734 4.352.24 7.422-2.831 6.649-6.916zm-11.062 3.511c-1.246 1.453-4.011 3.976-4.011 3.976s-.121.119-.31.023c-.076-.057-.108-.09-.108-.09-.443-.441-3.368-3.049-4.034-3.954-.709-.965-1.041-2.7-.091-3.71.951-1.01 3.005-1.086 4.363.407 0 0 1.565-1.782 3.468-.963 1.904.82 1.832 3.011.723 4.311zm6.173.478c-.928.116-1.682.028-1.682.028V7.284h1.77s1.971.551 1.971 2.638c0 1.913-.985 2.667-2.059 3.015z';

const uses = [
    { title: 'Servers and infrastructure', body: 'Hosting, cloud sync and the backend that keeps alarms, XP and friends in sync.' },
    { title: 'New features', body: 'More wake-up challenges, better sleep estimates, sound packs and the things you ask for.', link: { href: 'roadmap.html', label: 'See the roadmap' } },
    { title: 'Keeping it free and private', body: 'The core app stays free, with no ads, and your sensor and Health Connect data stay on your phone. That doesn’t change.' },
];
---
<BaseLayout
    title={"Support Nooze: buy me a coffee | Nooze Alarm"}
    description={"Nooze is free and built by one developer. If you’d like to chip in, you can buy me a coffee on Ko-fi."}
    keywords={"support nooze, donate nooze, nooze ko-fi, buy coffee nooze alarm"}
    canonical={"support.html"}
    ogTitle={"Support Nooze: buy me a coffee"}
    ogDescription={"Nooze is free and built by one developer. If you’d like to chip in, you can buy me a coffee on Ko-fi."}
    active={"support"}
>

  <Fragment slot="head">
    <script type="application/ld+json" set:html={"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://noozealarm.com/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Support\",\"item\":\"https://noozealarm.com/support.html\"}]}"} />
  </Fragment>

<main id="main" class="flex-1">
    <PageHeader
        title="Nooze is free. <br />Coffee is optional."
        lede="Nooze is built by one developer, with no ads or data sales. If you’d like to chip in, thank you. If not, enjoy the app."
    />

    <section class="nz-section sp-main" aria-labelledby="spKofiTitle">
        <div class="nz-container">

            <!-- The one primary action -->
            <div class="nz-panel sp-ticket nz-reveal">
                <div class="nz-panel-core sp-ticket-core">
                    <div class="sp-ticket-copy">
                        <p class="sp-ticket-src">
                            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={kofiPath} /></svg>
                            ko-fi.com/noozealarm
                        </p>
                        <h2 class="nz-h2" id="spKofiTitle">Buy me a coffee</h2>
                        <p class="sp-ticket-body">
                            A coffee helps keep the servers up, the app ad-free and new features shipping. It goes
                            straight to the one person who builds Nooze.
                        </p>
                    </div>
                    <div class="sp-ticket-stub">
                        <p class="sp-ticket-src">Optional, any amount</p>
                        <div class="sp-ticket-act">
                        <a class="nz-btn nz-btn--primary nz-btn--icon" href={KOFI} target="_blank" rel="noopener noreferrer">
                            <span>Support on Ko-fi</span>
                            <span class="nz-btn-icon" aria-hidden="true">
                                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 8h11M9 3.5 13.5 8 9 12.5" /></svg>
                            </span>
                            <span class="sr-only"> (opens Ko-fi)</span>
                        </a>
                        <p class="sp-ticket-note">Whenever you like. The free app stays free either&nbsp;way.</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Where it goes -->
            <div class="sp-uses">
                <h2 class="sp-uses-h nz-reveal" id="spUsesTitle">Where your support goes</h2>
                <ul class="nz-rows nz-rows--plain" aria-labelledby="spUsesTitle" data-stagger>
                    {uses.map((u) => (
                        <li class="nz-row nz-reveal">
                            <h3 class="nz-row-title">{u.title}</h3>
                            <div class="nz-row-body">
                                <p>{u.body}</p>
                                {u.link && (
                                    <a class="nz-arrowlink sp-row-link" href={u.link.href}>
                                        <span>{u.link.label}</span>
                                        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 8h11M9 3.5 13.5 8 9 12.5" /></svg>
                                    </a>
                                )}
                            </div>
                        </li>
                    ))}
                </ul>
            </div>
        </div>
    </section>

    <!-- Free ways to help -->
    <section class="nz-section nz-section--tight nz-band" aria-labelledby="spFreeTitle">
        <div class="nz-container sp-free">
            <div class="sp-free-head nz-reveal">
                <h2 class="nz-h2" id="spFreeTitle">Free ways to help</h2>
                <p class="sp-free-lede">Not everyone can donate, and that’s completely fine. These help Nooze grow too.</p>
            </div>

            <ul class="sp-free-list" data-stagger>
                <li class="nz-reveal">
                    <a class="sp-free-item" href={launch.playUrl} target="_blank" rel="noopener noreferrer">
                        <span class="sp-free-t">Rate Nooze on Google Play</span>
                        <span class="sp-free-b">A short review helps other people find it.</span>
                        <svg class="sp-free-arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.5 11.5l7-7M5.5 4.5h6v6" /></svg>
                        <span class="sr-only"> (opens Google Play)</span>
                    </a>
                </li>
                <li class="nz-reveal">
                    <button class="sp-free-item" type="button" data-share data-url={launch.playUrl}>
                        <span class="sp-free-t">Tell a friend</span>
                        <span class="sp-free-b" data-share-msg aria-live="polite">Know someone who hits snooze ten times? Send them the link.</span>
                        <svg class="sp-free-arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 10.5V2.5M5 5.5l3-3 3 3M3.5 8.5v4.5h9V8.5" /></svg>
                    </button>
                </li>
                <li class="nz-reveal">
                    <a class="sp-free-item" href="contact.html">
                        <span class="sp-free-t">Send feedback</span>
                        <span class="sp-free-b">Bugs, ideas or gripes. I read everything.</span>
                        <svg class="sp-free-arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 8h11M9 3.5 13.5 8 9 12.5" /></svg>
                    </a>
                </li>
            </ul>
        </div>
    </section>
</main>
</BaseLayout>

<script>
    // "Tell a friend": native share sheet where available, otherwise copy the Play link.
    const btn = document.querySelector<HTMLButtonElement>('[data-share]');
    const msg = btn?.querySelector<HTMLElement>('[data-share-msg]');
    if (btn && msg) {
        const original = msg.textContent;
        let timer: number | undefined;
        const say = (text: string) => {
            msg.textContent = text;
            window.clearTimeout(timer);
            timer = window.setTimeout(() => { msg.textContent = original; }, 2600);
        };
        btn.addEventListener('click', async () => {
            const url = btn.dataset.url || 'https://noozealarm.com/';
            const data = { title: 'Nooze', text: 'The no-snooze alarm I use. Free on Android:', url };
            if (navigator.share) {
                try { await navigator.share(data); } catch { /* closed the sheet */ }
                return;
            }
            try {
                await navigator.clipboard.writeText(url);
                say('Link copied. Paste it wherever your friends are.');
            } catch {
                say('Copy this link: ' + url);
            }
        });
    }
</script>

<style>
    /* ---- Ko-fi ticket ---- */
    .sp-ticket-core {
        display: grid;
        grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
        padding: 0;
    }
    .sp-ticket-copy { padding: clamp(28px, 4vw, 56px); }
    .sp-ticket-src {
        display: inline-flex; align-items: center; gap: 10px; margin: 0 0 28px;
        font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.04em; color: var(--fg-3);
    }
    .sp-ticket-src svg { width: 16px; height: 16px; color: var(--fg-2); }
    .sp-ticket-body { margin: 22px 0 0; font-size: clamp(17px, 1.3vw, 19px); line-height: 1.6; color: var(--fg-2); max-width: 40ch; }

    /* The stub: torn off along a perforated line */
    .sp-ticket-stub {
        position: relative;
        display: grid; grid-template-rows: auto 1fr; justify-items: start;
        padding: clamp(28px, 4vw, 56px);
        background: rgba(255, 255, 255, 0.015);
    }
    .sp-ticket-stub .sp-ticket-src { margin-bottom: 0; }
    .sp-ticket-act { display: grid; align-content: end; justify-items: start; gap: 18px; padding-top: 28px; }
    .sp-ticket-stub::before {
        content: ''; position: absolute; left: 0; top: 18px; bottom: 18px; width: 1px;
        background: repeating-linear-gradient(to bottom, var(--line-3) 0 3px, transparent 3px 9px);
    }
    .sp-ticket-note { margin: 0; font-size: 14.5px; line-height: 1.55; color: var(--fg-3); max-width: 30ch; }

    /* ---- Where it goes ---- */
    .sp-uses { margin-top: clamp(96px, 11vw, 152px); }
    .sp-uses-h {
        margin: 0 0 clamp(32px, 4vw, 48px);
        font-size: clamp(30px, 3.2vw, 44px); line-height: 1.05; letter-spacing: -0.03em;
    }
    .nz-row-body p { margin: 0; }
    .sp-row-link { margin-top: 8px; padding: 10px 0; }

    /* ---- Free ways ---- */
    .sp-free {
        display: grid;
        grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
        gap: clamp(32px, 6vw, 96px);
        align-items: start;
    }
    .sp-free-lede { margin: 20px 0 0; font-size: 17px; line-height: 1.6; color: var(--fg-2); max-width: 34ch; }
    .sp-free-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
    .sp-free-list li { border-bottom: 1px solid var(--line); }
    .sp-free-item {
        display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 4px 20px; align-items: center;
        width: 100%; min-height: 44px; padding: 22px 4px 22px 0;
        background: none; border: 0; text-align: left; color: inherit; font: inherit; cursor: pointer;
    }
    .sp-free-t {
        grid-column: 1;
        font-family: var(--font-display); font-size: clamp(19px, 1.5vw, 22px); font-weight: 600;
        letter-spacing: -0.02em; line-height: 1.25; color: var(--fg);
    }
    .sp-free-b { grid-column: 1; font-size: 15.5px; line-height: 1.5; color: var(--fg-2); }
    .sp-free-arrow {
        grid-column: 2; grid-row: 1 / span 2;
        width: 18px; height: 18px; color: var(--fg-3);
        transition: transform 0.45s var(--ease-out), color 0.25s var(--ease-out);
    }
    .sp-free-item:hover .sp-free-arrow, .sp-free-item:focus-visible .sp-free-arrow { color: var(--red); transform: translateX(3px); }
    .sp-free-item:hover .sp-free-t { text-decoration: underline; text-decoration-color: var(--line-3); text-decoration-thickness: 1px; text-underline-offset: 5px; }

    @media (max-width: 900px) {
        .sp-ticket-core { grid-template-columns: minmax(0, 1fr); }
        .sp-ticket-copy { padding-bottom: 28px; }
        .sp-ticket-stub { padding-top: 28px; }
        .sp-ticket-stub::before {
            left: 18px; right: 18px; top: 0; bottom: auto; width: auto; height: 1px;
            background: repeating-linear-gradient(to right, var(--line-3) 0 3px, transparent 3px 9px);
        }
        .sp-free { grid-template-columns: minmax(0, 1fr); }
    }
    @media (prefers-reduced-motion: reduce) {
        .sp-free-arrow { transition: none; }
    }
</style>
