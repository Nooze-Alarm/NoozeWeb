---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ClosingCta from '../components/ClosingCta.astro';

// The three ideas Nooze grew from, told as equals.
const ideas = [
    {
        title: 'Ring at a lighter moment.',
        body: 'What if the alarm could estimate your sleep and ring at a lighter moment inside a window, instead of a random one?',
    },
    {
        title: 'Make stopping it a task.',
        body: 'Snoozing turns one alarm into several and trains you to dread mornings. Take the snooze button away, make the dismissal a tiny challenge, and waking up becomes something you finish.',
    },
    {
        title: 'Reward the morning.',
        body: 'Habits stick when there’s feedback. So Nooze tracks streaks, awards XP, unlocks achievements and lets you duel friends. The morning becomes a win, not a chore.',
    },
];

const principles = [
    {
        title: 'Privacy first',
        body: 'Sensor, microphone, calendar and Health Connect data stay on your phone. With an account, only your profile, XP and social activity sync. No ads, no data sales, and you can delete your account and cloud data from inside the app.',
    },
    {
        title: 'No dark patterns',
        body: 'No upsell pop-ups, and every feature has to earn its place. Alarms, every challenge and sleep tracking are free. Premium is optional (€1.99 a month or €13.99 a year) and adds extras, not the basics.',
    },
    {
        title: 'Honest estimates',
        body: 'Smart wake uses motion, sound or wearable data to pick an estimated lighter moment to ring, and Nooze says so plainly. Every sleep figure in the app is an estimate for general wellness, not medical advice.',
    },
];
---
<BaseLayout
    title={"About: the story behind the alarm | Nooze Alarm"}
    description={"Nooze started as one developer’s fix for rough mornings. The story, the principles and how to reach me."}
    keywords={"about nooze, nooze alarm story, smart alarm developer, sleep app mission, indie alarm app"}
    canonical={"about.html"}
    ogTitle={"About Nooze: the alarm I wanted to wake up to"}
    ogDescription={"Nooze started as one developer’s fix for rough mornings. The story, the principles and how to reach me."}
    active={"about"}
>

  <Fragment slot="head">
    <script type="application/ld+json" set:html={"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://noozealarm.com/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"About\",\"item\":\"https://noozealarm.com/about.html\"}]}"} />
  </Fragment>

<main id="main" class="flex-1">
    <PageHeader
        title="The alarm I wanted to wake up&nbsp;to."
        lede="Nooze started as one person’s fix for rough mornings. It’s now live on Google Play, still built by one developer in Bulgaria."
    />

    <!-- Origin story -->
    <section class="nz-section" aria-labelledby="abStoryTitle">
        <div class="nz-container">
            <div class="nz-split">
                <div class="nz-split-head">
                    <h2 class="nz-h2" id="abStoryTitle">How it started</h2>
                </div>

                <div class="ab-story">
                    <p class="ab-lead nz-reveal">
                        Nooze started with my own bad mornings. Ordinary alarms only made them worse:
                        getting yanked awake left me more exhausted than when I went to bed.
                        <span class="ab-lead-turn">Three ideas came out of that.</span>
                    </p>

                    <ol class="ab-ideas" data-stagger>
                        {ideas.map((idea) => (
                            <li class="nz-reveal">
                                <h3 class="ab-idea-title">{idea.title}</h3>
                                <p class="ab-idea-body">{idea.body}</p>
                            </li>
                        ))}
                    </ol>

                    <p class="ab-close nz-reveal">
                        They grew into nine wake-up challenges, a smart wake window and streaks you share with friends.
                        There is no snooze button and there are no ads, and it is still one developer doing the design,
                        code and support. Since November 2026, Nooze has been live on Google Play as Nooze Sleep Tracker &amp; Alarm.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Founder note -->
    <section class="nz-section nz-band" aria-labelledby="abNoteTitle">
        <div class="nz-container ab-note">
            <div class="ab-note-side nz-reveal">
                <img class="ab-note-mark" src="/assets/logo-160.webp" alt="" width="56" height="56" loading="lazy" />
                <h2 class="ab-note-title" id="abNoteTitle">A note from the developer</h2>
            </div>

            <div class="ab-note-main nz-reveal" style="--d:1">
                <div class="ab-note-text">
                    <p>
                        I built Nooze end to end: the alarm engine, the sleep tracking, the gamification, the lot.
                        The app you install is the work of one person who’s a little obsessed with making mornings better.
                    </p>
                    <p>If something breaks, feels off or is missing, write to me. I read everything.</p>
                </div>

                <p class="ab-sign">
                    <span class="ab-sign-name">Teodor Mirchev</span>
                    <span class="nz-meta">Founder and developer</span>
                </p>

                <dl class="ab-contact">
                    <div>
                        <dt>Email</dt>
                        <dd><a class="nz-link" href="mailto:noozealarm@gmail.com">noozealarm@gmail.com</a></dd>
                    </div>
                    <div>
                        <dt>LinkedIn</dt>
                        <dd class="ab-dd-links">
                            <a class="nz-link" href="https://www.linkedin.com/in/teodor-mirchev-91115a305" target="_blank" rel="noopener noreferrer">
                                Teodor Mirchev<span class="sr-only"> (opens LinkedIn)</span>
                            </a>
                            <a class="nz-link" href="https://www.linkedin.com/company/nooze-alarm" target="_blank" rel="noopener noreferrer">
                                Nooze Alarm<span class="sr-only"> (opens LinkedIn)</span>
                            </a>
                        </dd>
                    </div>
                    <div>
                        <dt>Based in</dt>
                        <dd>Bulgaria</dd>
                    </div>
                </dl>
            </div>
        </div>
    </section>

    <!-- Principles -->
    <section class="nz-section" aria-labelledby="abValuesTitle">
        <div class="nz-container">
            <div class="nz-head nz-reveal">
                <h2 class="nz-h2" id="abValuesTitle">What Nooze stands for</h2>
                <p class="nz-lede">Three rules that shape every feature, free or Premium.</p>
            </div>

            <ul class="nz-rows nz-rows--plain ab-rows" data-stagger>
                {principles.map((p) => (
                    <li class="nz-row nz-reveal">
                        <h3 class="nz-row-title">{p.title}</h3>
                        <p class="nz-row-body">{p.body}</p>
                    </li>
                ))}
            </ul>
        </div>
    </section>

    <ClosingCta secondary={{ href: '/roadmap.html', label: 'See the roadmap' }} />
</main>
</BaseLayout>

<style>
    /* ---- Story ---- */
    .ab-story { display: grid; gap: 0; }
    .ab-lead {
        margin: 0;
        font-size: clamp(21px, 1.8vw, 25px);
        line-height: 1.45;
        letter-spacing: -0.012em;
        color: var(--fg);
        max-width: 32em;
    }
    .ab-lead-turn { display: block; margin-top: 0.9em; color: var(--fg-2); }
    /* Three ideas, equal weight */
    .ab-ideas { list-style: none; margin: clamp(36px, 4vw, 52px) 0 0; padding: 0; border-top: 1px solid var(--line); max-width: 36em; }
    .ab-ideas li { padding: 26px 0 28px; border-bottom: 1px solid var(--line); }
    .ab-idea-title { margin: 0; font-family: var(--font-display); font-size: 22px; font-weight: 600; letter-spacing: -0.02em; line-height: 1.25; color: var(--fg); }
    .ab-idea-body { margin: 10px 0 0; font-size: 17px; line-height: 1.6; color: var(--fg-2); max-width: 34em; }
    .ab-close { margin: clamp(32px, 3.5vw, 44px) 0 0; font-size: 17px; line-height: 1.65; color: var(--fg-2); max-width: 36em; }

    /* ---- Founder note ---- */
    .ab-note {
        display: grid;
        grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
        gap: clamp(32px, 6vw, 96px);
        align-items: start;
    }
    .ab-note-side { display: grid; gap: 24px; justify-items: start; }
    .ab-note-mark { width: 56px; height: 56px; border-radius: 14px; box-shadow: 0 14px 36px -18px rgba(59, 140, 255, 0.55); }
    .ab-note-title { margin: 0; font-size: clamp(28px, 3.2vw, 44px); line-height: 1.04; letter-spacing: -0.03em; max-width: 9em; }
    .ab-note-text p {
        margin: 0;
        font-size: clamp(20px, 1.75vw, 25px);
        line-height: 1.5;
        letter-spacing: -0.012em;
        color: var(--fg);
        max-width: 30em;
    }
    .ab-note-text p + p { margin-top: 0.9em; color: var(--fg-2); }
    .ab-sign { display: grid; gap: 6px; margin: 40px 0 0; }
    .ab-sign-name { font-family: var(--font-display); font-size: 20px; font-weight: 600; letter-spacing: -0.02em; color: var(--fg); }
    .ab-contact { margin: 36px 0 0; border-top: 1px solid var(--line); max-width: 30em; }
    .ab-contact > div {
        display: grid; grid-template-columns: 112px minmax(0, 1fr); align-items: center; gap: 16px;
        min-height: 56px; border-bottom: 1px solid var(--line);
    }
    .ab-contact dt { font-family: var(--font-mono); font-size: 11.5px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--fg-3); }
    .ab-contact dd { margin: 0; color: var(--fg); font-size: 16px; overflow-wrap: anywhere; }
    .ab-contact a { display: inline-block; padding: 10px 0; }
    .ab-contact .ab-dd-links { display: flex; flex-wrap: wrap; column-gap: 24px; }

    .ab-rows { margin-top: clamp(48px, 6vw, 80px); }

    @media (max-width: 900px) {
        .ab-note { grid-template-columns: minmax(0, 1fr); }
        .ab-note-side { grid-template-columns: auto minmax(0, 1fr); align-items: center; gap: 18px; }
        .ab-note-mark { width: 44px; height: 44px; border-radius: 11px; }
        .ab-note-title { max-width: none; }
    }
    @media (max-width: 520px) {
        .ab-contact > div { grid-template-columns: 88px minmax(0, 1fr); gap: 12px; }
    }
</style>
