---
import BaseLayout from '../layouts/BaseLayout.astro';
import { launch } from '../data/launch';
---
<BaseLayout
    title={"You're invited to Nooze | Nooze Alarm"}
    description={"A friend wants to add you on Nooze, the no-snooze alarm."}
    canonical={"invite.html"}
    noindex={true}
    footer={"minimal"}
>

<main id="main" class="flex-1 inv">
    <div class="nz-container">
        <p class="nz-kicker">Friend invite</p>
        <h1 class="inv-title">You're invited to Nooze</h1>
        <p class="nz-lede inv-lede">A friend wants to add you on Nooze, the no-snooze alarm. Install the app and sign in, and you'll be asked to confirm the friend request.</p>
        <div class="nz-btn-group inv-actions">
            <a id="inv-play" class="nz-btn nz-btn--primary nz-btn--icon" href={launch.playUrl} rel="noopener noreferrer">
                <span>Get Nooze on Google Play</span>
                <span class="nz-btn-icon" aria-hidden="true">
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 8h11M9 3.5 13.5 8 9 12.5" /></svg>
                </span>
            </a>
            <a id="inv-open" class="nz-btn nz-btn--ghost" href="#" hidden>Already have Nooze? Open it</a>
        </div>
    </div>
</main>
</BaseLayout>

<script is:inline>
(function () {
    var m = /^\/invite\/([A-Za-z0-9_-]{1,128})\/?$/.exec(location.pathname);
    if (!m) return;
    var uid = m[1];
    var playUrl = 'https://play.google.com/store/apps/details?id=com.noozealarm.app&referrer=' +
        encodeURIComponent('utm_source=friend_invite&utm_medium=share&invite=' + uid);
    var play = document.getElementById('inv-play');
    if (play) play.href = playUrl;
    var open = document.getElementById('inv-open');
    if (open && /Android/i.test(navigator.userAgent)) {
        open.href = 'intent://friend/invite/' + uid +
            '#Intent;scheme=nooze;package=com.noozealarm.app;S.browser_fallback_url=' +
            encodeURIComponent(playUrl) + ';end';
        open.hidden = false;
    }
})();
</script>

<style>
    .inv {
        padding-block: calc(var(--nav-h) + clamp(40px, 6vw, 80px)) clamp(56px, 7vw, 96px);
    }
    .inv-title {
        margin: 0;
        font-size: clamp(36px, 5vw, 68px); font-weight: 600; line-height: 1; letter-spacing: -0.04em;
        max-width: 14ch;
    }
    .inv-lede { margin-top: 24px; max-width: 52ch; }
    .inv-actions { margin-top: 36px; }
    .inv-actions [hidden] { display: none; }
</style>
