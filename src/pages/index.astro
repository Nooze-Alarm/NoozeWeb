---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Screenshots from '../components/Screenshots.astro';
import WakeWindowDiagram from '../components/WakeWindowDiagram.astro';
import PlayButton from '../components/PlayButton.astro';
import ClosingCta from '../components/ClosingCta.astro';
import { launch } from '../data/launch';

const description = 'Nooze is a no-snooze alarm for Android with wake-up challenges, a smart wake window, sleep tracking and friend wake duels. Free on Google Play.';

const appLd = {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: launch.appName,
    alternateName: 'Nooze Alarm',
    operatingSystem: 'Android',
    applicationCategory: 'HealthApplication',
    description: 'No-snooze alarm with wake-up challenges, sleep tracking and friend wake duels.',
    url: 'https://noozealarm.com/',
    installUrl: launch.playUrl,
    offers: [
        { '@type': 'Offer', price: '0', priceCurrency: 'EUR', availability: 'https://schema.org/InStock', category: 'Free' },
        { '@type': 'Offer', name: 'Nooze Premium (Monthly)', price: '1.99', priceCurrency: 'EUR', category: 'subscription' },
        { '@type': 'Offer', name: 'Nooze Premium (Yearly)', price: '13.99', priceCurrency: 'EUR', category: 'subscription' },
    ],
    author: { '@type': 'Person', name: 'Teodor Mirchev' },
};
const orgLd = {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Nooze Alarm',
    url: 'https://noozealarm.com',
    logo: 'https://noozealarm.com/assets/logo.png',
    sameAs: ['https://x.com/NoozeAlarm', 'https://www.tiktok.com/@nooze.alarm.app', 'https://github.com/Nooze-Alarm', 'https://www.linkedin.com/company/nooze-alarm'],
    contactPoint: { '@type': 'ContactPoint', email: 'noozealarm@gmail.com', contactType: 'customer support' },
};
const siteLd = {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Nooze Alarm',
    alternateName: 'Nooze',
    url: 'https://noozealarm.com/',
    description: 'No-snooze alarm and sleep tracker for Android with wake-up challenges and friend wake duels.',
    publisher: { '@type': 'Organization', name: 'Nooze Alarm', logo: 'https://noozealarm.com/assets/logo.png' },
};

// ---------- 1. A Nooze morning: the departure board ----------
const settings = [
    { k: 'Alarm', v: '07:00' },
    { k: 'Smart wake', v: '30 min window' },
    { k: 'Challenge', v: 'Math, medium' },
    { k: 'Wake-up check', v: 'On' },
];
const morning = [
    { t: '06:30', title: 'The window opens', body: 'Thirty minutes before your alarm, Nooze starts looking for an estimated lighter moment to ring.', status: 'Window open' },
    { t: '06:42', title: 'Nooze rings', body: 'At an estimated lighter moment, 18 minutes early. There is no snooze button to reach for.', status: 'Ringing', ring: true },
    { t: '06:43', title: '12 + 37 = 49', mono: true, body: 'Challenge solved, alarm off. Not into math? Pick shake, steps, a QR code or one of the others.', status: 'Alarm off' },
    { t: '06:48', title: '“Still up?”', body: 'The wake-up check makes sure you did not crawl back under. Ignore it and the alarm rings again.', status: 'Confirmed' },
    { t: '+XP', title: 'Streak kept', body: 'An on-time wake-up earns XP, adds a day to your streak and counts in any wake duel you have running.', status: 'On time' },
];
const challenges = [
    { name: 'Math' }, { name: 'Memory' }, { name: 'Shake' }, { name: 'Steps' },
    { name: 'Read aloud', note: '*' }, { name: 'QR or barcode', note: '†' }, { name: 'NFC tag', note: '†' },
    { name: 'Typing' }, { name: 'Photo task', note: '†' },
];

// ---------- 4. Everything else ----------
const rows = [
    { title: 'Stay accountable', body: 'Earn XP for on-time wake-ups and climb the leaderboards with friends. Start a wake duel, share one streak with a squad of up to four, or pick a wake-up buddy who gets one nudge if you miss your check.' },
    { title: 'Alarms that fit your week', body: 'Skip just the next alarm, pause for a holiday, skip public holidays from your calendar or ring earlier when the day starts with an early event. A different sound each day, and your home time zone kept while you travel.' },
    { title: 'Naps and widgets', body: 'One-tap naps, home-screen widgets and a live countdown on your lock screen.', tags: ['20 min', '30 min', '45 min'] },
    { title: 'Sleep tracking, estimated', body: 'Your phone’s motion sensor and optional microphone estimate how long you slept, your sleep phases and noise like snoring, with an approximate quality score and weekly trends. For general wellness.' },
    { title: 'Health Connect', body: 'Wear a compatible band or watch? With your permission, Nooze can use its sleep and heart-rate data through Health Connect.' },
    { title: 'Sleep sounds and breathing', body: 'Calming sounds, a guided breathing exercise and a short morning journal for the bookends of your night.' },
    { title: 'Smart home', premium: true, body: 'When the alarm fires, switch on the lights or start a routine.', tags: ['Home Assistant', 'Tuya', 'Tellur', 'Any webhook'] },
    { title: 'Wear OS', body: 'A watch companion with a next-alarm tile, and the alarm rings on your wrist too.' },
    { title: 'Private by default', body: 'Sensor, microphone, calendar and Health Connect data stay on your phone. No ads, and no data sales.' },
];

// ---------- 5. Pricing ----------
const freeList = [
    'Unlimited alarms with smart wake',
    'All nine wake-up challenges',
    'The wake-up check',
    'Sleep tracking and weekly trends',
    'XP, streaks, friends and wake duels',
    '6 themes',
];
const premiumList = [
    'Everything in Free',
    '6 more themes with animated backgrounds',
    'Advanced sleep analytics',
    'The full sleep sound library',
    'Smart home: Home Assistant, Tuya, Tellur or any webhook',
    'A spoken morning briefing: weather, next alarm, first event',
];
---
<BaseLayout
    title={"No-snooze smart alarm and sleep tracker for Android | Nooze Alarm"}
    description={description}
    keywords={"no snooze alarm, alarm clock with challenges, smart alarm clock, sleep tracker android, smart wake alarm, gamified alarm clock, wake up alarm android, wake duels"}
    canonical={""}
    ogTitle={"Nooze Alarm: wake up smarter"}
    ogDescription={"The no-snooze alarm with wake-up challenges, a smart wake window and friends who keep you honest. Android."}
    active={"home"}
>

  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(appLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(siteLd)} />
  </Fragment>

<main id="main" class="flex-1">
    <Hero />

    <!-- 1. A Nooze morning: the wake-up as a departure board -->
    <section class="nz-section hm-how" id="how" aria-labelledby="howTitle">
        <div class="nz-container">
            <div class="nz-head nz-reveal">
                <p class="nz-kicker">A Nooze morning</p>
                <h2 class="nz-h2" id="howTitle">Tomorrow morning, minute by minute.</h2>
                <p class="nz-lede">One alarm, from the moment the window opens to the moment it counts.</p>
            </div>

            <div class="hm-board">
                <dl class="hm-board-head nz-reveal" aria-label="Example alarm settings">
                    {settings.map((s) => (
                        <div class="hm-set">
                            <dt>{s.k}</dt>
                            <dd>{s.v}</dd>
                        </div>
                    ))}
                </dl>

                <ol class="hm-rows">
                    {morning.map((r) => (
                        <li class:list={['hm-row', 'nz-reveal', r.ring && 'is-ring']}>
                            <p class="hm-time">
                                <span class="sr-only">{r.t === '+XP' ? 'Then' : r.t}</span>
                                <span class="hm-digits" aria-hidden="true">
                                    {[...r.t].map((ch, i) => (
                                        <span class:list={['hm-ch', ch === ':' && 'is-colon']} style={`--c:${i}`}><span>{ch}</span></span>
                                    ))}
                                </span>
                            </p>
                            <h3 class:list={['hm-row-title', r.mono && 'is-mono']}>{r.title}</h3>
                            <p class="hm-row-body">{r.body}</p>
                            <p class="hm-status">
                                {r.ring && <span class="hm-status-dot" aria-hidden="true"></span>}
                                {r.status}
                            </p>
                        </li>
                    ))}
                </ol>
            </div>

            <div class="hm-ways nz-reveal">
                <div class="hm-ways-head">
                    <h3 class="nz-h3">Nine ways to switch it off</h3>
                    <p class="hm-ways-body">Pick one challenge per alarm and set it to easy, medium or hard.</p>
                </div>
                <div class="hm-ways-list">
                    <ul class="nz-tags hm-tags" aria-label="Wake-up challenges">
                        {challenges.map((c) => (
                            <li class="nz-tag">{c.name}{c.note && <sup aria-hidden="true">{c.note}</sup>}</li>
                        ))}
                    </ul>
                    <p class="hm-notes">
                        <span><sup aria-hidden="true">&dagger;</sup> Offers math after 2 minutes, so you are never stuck.</span>
                        <span><sup aria-hidden="true">*</sup> On supported phones.</span>
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- 2. Smart wake window: an honest, illustrative diagram -->
    <section class="nz-section nz-band hm-wake" aria-labelledby="wakeTitle">
        <div class="nz-container">
            <div class="nz-head nz-reveal">
                <h2 class="nz-h2" id="wakeTitle">A wake window instead of a fixed time.</h2>
                <p class="nz-lede">Choose 15, 20 or 30 minutes before your alarm. Nooze picks an estimated lighter moment inside that window to ring.</p>
            </div>

            <WakeWindowDiagram />

        </div>
    </section>

    <!-- 3. Real app screens -->
    <Screenshots />

    <!-- 4. Everything else -->
    <section class="nz-section hm-more" aria-labelledby="moreTitle">
        <div class="nz-container nz-split">
            <div class="nz-split-head nz-reveal">
                <h2 class="nz-h2" id="moreTitle">Everything around the alarm.</h2>
                <p class="nz-lede hm-more-lede">Friends who keep you honest, alarms that follow your calendar, naps, sleep estimates and a few quiet extras.</p>
            </div>
            <div>
                <ul class="nz-rows hm-more-rows">
                    {rows.map((r) => (
                        <li class="nz-row nz-reveal">
                            <div class="hm-more-main">
                                <h3 class="nz-row-title">
                                    {r.title}
                                    {r.premium && <span class="nz-tag hm-prem">Premium</span>}
                                </h3>
                                <p class="nz-row-body">{r.body}</p>
                                {r.tags && (
                                    <ul class="nz-tags hm-row-tags">
                                        {r.tags.map((t) => <li class="nz-tag">{t}</li>)}
                                    </ul>
                                )}
                            </div>
                        </li>
                    ))}
                </ul>
                <p class="hm-more-link nz-reveal">
                    <a class="nz-arrowlink" href="features.html">
                        <span>See every feature</span>
                        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 8h11M9 3.5 13.5 8 9 12.5" /></svg>
                    </a>
                </p>
            </div>
        </div>
    </section>

    <!-- 5. Pricing -->
    <section class="nz-section nz-band hm-price" id="pricing" aria-labelledby="priceTitle">
        <div class="nz-container">
            <div class="nz-head nz-reveal">
                <h2 class="nz-h2" id="priceTitle">Free to use. Premium if you want more.</h2>
                <p class="nz-lede">Everything that gets you up is free, with no ads. Premium is an optional upgrade inside the app.</p>
            </div>

            <div class="hm-plans" data-stagger>
                <article class="hm-plan hm-plan--free nz-reveal" aria-labelledby="planFree">
                    <header class="hm-plan-head">
                        <h3 class="hm-plan-name" id="planFree">Free</h3>
                    </header>
                    <p class="hm-plan-price"><span class="hm-amt">&euro;0</span><span class="hm-per">no subscription</span></p>
                    <p class="hm-plan-note">No ads. Start as a guest and sign in when you want friends and duels.</p>
                    <ul class="hm-feats">
                        {freeList.map((x) => (
                            <li><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8.5 6.5 12 13 4.5" /></svg>{x}</li>
                        ))}
                    </ul>
                    <div class="hm-plan-foot">
                        <PlayButton />
                    </div>
                </article>

                <div class="nz-panel hm-plan-panel nz-reveal">
                    <article class="nz-panel-core hm-plan hm-plan--premium" aria-labelledby="planPremium">
                        <input class="hm-bill-in" type="radio" name="hm-bill" id="hmBillM" value="monthly" checked />
                        <input class="hm-bill-in" type="radio" name="hm-bill" id="hmBillY" value="yearly" />
                        <header class="hm-plan-head">
                            <h3 class="hm-plan-name" id="planPremium">Premium</h3>
                            <fieldset class="hm-bill">
                                <legend class="sr-only">Billing period</legend>
                                <span class="hm-bill-thumb" aria-hidden="true"></span>
                                <label for="hmBillM">Monthly</label>
                                <label for="hmBillY">Yearly</label>
                            </fieldset>
                        </header>
                        <p class="hm-plan-price">
                            <span class="hm-swap hm-swap--m"><span class="hm-amt">&euro;1.99</span><span class="hm-per">per month</span></span>
                            <span class="hm-swap hm-swap--y"><span class="hm-amt">&euro;13.99</span><span class="hm-per">per year</span></span>
                        </p>
                        <p class="hm-plan-note">
                            <span class="hm-swap hm-swap--m">Or &euro;13.99 a year, about 41% less. Cancel any time in Google Play.</span>
                            <span class="hm-swap hm-swap--y">About &euro;1.17 a month, 41% less than monthly. Cancel any time in Google Play.</span>
                        </p>
                        <ul class="hm-feats">
                            {premiumList.map((x) => (
                                <li><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8.5 6.5 12 13 4.5" /></svg>{x}</li>
                            ))}
                        </ul>
                        <p class="hm-plan-foot hm-plan-foot--note">Start free and upgrade inside the app whenever you like.</p>
                    </article>
                </div>
            </div>
        </div>
    </section>

    <ClosingCta />
</main>
</BaseLayout>

<style>

    /* ===================== 1. A Nooze morning ===================== */
    .hm-board { margin-top: clamp(56px, 7vw, 96px); }

    .hm-board-head {
        display: grid; grid-template-columns: repeat(4, minmax(0, 1fr));
        margin: 0; border-top: 1px solid var(--line-2);
    }
    .hm-set { padding: 18px 20px 20px 0; }
    .hm-set + .hm-set { padding-left: 20px; border-left: 1px solid var(--line); }
    .hm-set dt {
        font-family: var(--font-mono); font-size: 11.5px; letter-spacing: 0.12em; text-transform: uppercase;
        color: var(--fg-3);
    }
    .hm-set dd { margin: 8px 0 0; font-family: var(--font-mono); font-size: 14px; color: var(--fg); font-variant-numeric: tabular-nums; }

    .hm-rows { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line-2); border-bottom: 1px solid var(--line-2); }
    .hm-row {
        position: relative; isolation: isolate;
        display: grid;
        grid-template-columns: minmax(0, 3.3fr) minmax(0, 2.7fr) minmax(0, 4fr) minmax(112px, auto);
        column-gap: clamp(20px, 3vw, 44px);
        align-items: baseline;
        padding: clamp(26px, 3vw, 40px) 0;
    }
    .hm-row + .hm-row { border-top: 1px solid var(--line); }

    .hm-time {
        margin: 0; font-family: var(--font-mono); font-weight: 400;
        font-size: clamp(46px, 6vw, 88px); line-height: 0.9; letter-spacing: -0.04em;
        color: var(--fg); font-variant-numeric: tabular-nums;
    }
    .hm-digits { display: inline-flex; }
    .hm-ch { display: inline-block; overflow: hidden; padding-bottom: 0.06em; margin-bottom: -0.06em; }
    .hm-ch.is-colon { margin-inline: -0.14em; }
    .hm-ch > span { display: inline-block; transition: transform 0.7s var(--ease-out); transition-delay: calc(120ms + var(--c) * 45ms); }
    :global(html.js) .hm-row:not(.is-in) .hm-ch > span { transform: translateY(105%); }

    .hm-row-title {
        margin: 0; font-family: var(--font-display); font-size: clamp(21px, 1.8vw, 26px);
        font-weight: 600; letter-spacing: -0.02em; line-height: 1.15; color: var(--fg);
    }
    .hm-row-title.is-mono { font-family: var(--font-mono); font-weight: 500; font-size: clamp(18px, 1.5vw, 21px); letter-spacing: -0.01em; font-variant-numeric: tabular-nums; }
    .hm-row-body { margin: 0; color: var(--fg-2); font-size: 16px; line-height: 1.55; max-width: 44ch; }
    .hm-status {
        margin: 0; justify-self: end; display: inline-flex; align-items: center; gap: 10px;
        font-family: var(--font-mono); font-size: 11.5px; letter-spacing: 0.12em; text-transform: uppercase;
        color: var(--fg-3); white-space: nowrap;
    }

    /* The ring: the one red moment on the board */
    .hm-row.is-ring .hm-time, .hm-row.is-ring .hm-status { color: var(--red); }
    .hm-row.is-ring::before {
        content: ''; position: absolute; left: calc(-1 * min(var(--gutter), 40px)); top: -1px; bottom: -1px; width: 2px;
        background: var(--red); transform-origin: top; transform: scaleY(0);
        transition: transform 0.9s var(--ease-out) 0.35s;
    }
    .hm-row.is-ring::after {
        content: ''; position: absolute; inset: -1px 0; z-index: -1; pointer-events: none;
        background: linear-gradient(90deg, rgba(255, 74, 61, 0.08), rgba(255, 74, 61, 0) 55%);
        border-top: 1px solid var(--red-line); border-bottom: 1px solid var(--red-line);
        opacity: 0; transition: opacity 0.9s var(--ease-out) 0.35s;
    }
    .hm-row.is-ring.is-in::before { transform: none; }
    .hm-row.is-ring.is-in::after { opacity: 1; }
    :global(html:not(.js)) .hm-row.is-ring::before { transform: none; }
    :global(html:not(.js)) .hm-row.is-ring::after { opacity: 1; }
    .hm-status-dot { position: relative; width: 7px; height: 7px; border-radius: 50%; background: var(--red); flex: none; }
    .hm-status-dot::after {
        content: ''; position: absolute; inset: -5px; border-radius: 50%; border: 1px solid var(--red-line); opacity: 0;
    }
    .hm-row.is-ring.is-in .hm-status-dot::after { animation: hmPing 1.6s var(--ease-out) 0.9s 3; }
    @keyframes hmPing { 0% { transform: scale(0.5); opacity: 1; } 80%, 100% { transform: scale(1.7); opacity: 0; } }

    /* Nine ways */
    .hm-ways {
        display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 24px clamp(40px, 6vw, 96px);
        margin-top: clamp(64px, 8vw, 112px); align-items: start;
    }
    .hm-ways-body { margin: 14px 0 0; color: var(--fg-2); max-width: 36ch; }
    .hm-tags { list-style: none; margin: 0; padding: 0; gap: 10px; }
    .hm-tags .nz-tag { padding: 10px 14px; font-size: 12.5px; color: var(--fg); }
    .hm-tags sup { top: -0.4em; margin-left: -5px; color: var(--fg-3); font-size: 0.92em; }
    .hm-notes { display: flex; flex-wrap: wrap; gap: 6px 28px; margin: 22px 0 0; font-size: 14px; color: var(--fg-3); }
    .hm-notes sup { top: 0; vertical-align: baseline; font-size: 1em; margin-right: 4px; font-family: var(--font-mono); }

    @media (max-width: 900px) {
        .hm-board-head { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .hm-set:nth-child(odd) { padding-left: 0; border-left: 0; }
        .hm-set:nth-child(n + 3) { border-top: 1px solid var(--line); }
        .hm-row {
            grid-template-columns: minmax(0, 1fr) auto;
            grid-template-areas: 'time status' 'title title' 'body body';
            row-gap: 14px;
        }
        .hm-time { grid-area: time; }
        .hm-status { grid-area: status; align-self: center; }
        .hm-row-title { grid-area: title; margin-top: 6px; }
        .hm-row-body { grid-area: body; }
        .hm-row.is-ring::before { left: calc(-1 * var(--gutter)); }
        .hm-ways { grid-template-columns: minmax(0, 1fr); }
    }

    /* ===================== 4. Everything else ===================== */
    .hm-more-lede { margin-top: 24px; }
    .hm-more-rows .nz-row { grid-template-columns: minmax(0, 1fr); }
    .hm-more-main { display: flex; flex-direction: column; gap: 10px; min-width: 0; }
    .hm-more-rows .nz-row-title { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
    .hm-prem { font-size: 11.5px; padding: 5px 9px; letter-spacing: 0.06em; text-transform: uppercase; }
    .hm-row-tags { list-style: none; margin: 6px 0 0; padding: 0; }
    .hm-more-link { display: flex; justify-content: flex-end; margin: 32px 0 0; }

    /* ===================== 5. Pricing ===================== */
    .hm-plans {
        display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr);
        grid-template-rows: repeat(10, auto);
        column-gap: clamp(24px, 4vw, 56px);
        margin-top: clamp(48px, 6vw, 80px);
    }
    .hm-plan { display: grid; grid-row: span 10; grid-template-rows: subgrid; align-content: start; }
    .hm-plan-panel { grid-row: span 10; display: grid; grid-template-rows: subgrid; }
    .hm-plan-panel > .hm-plan { grid-row: 1 / span 10; }
    /* Free sits on the page; match the panel's inset so rows line up */
    .hm-plan--free { padding: calc(6px + clamp(24px, 3vw, 40px)) 0 calc(6px + clamp(24px, 3vw, 40px)); border-top: 1px solid var(--line-2); }
    .hm-plan--premium { padding: clamp(24px, 3vw, 40px); }

    .hm-plan-head { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 52px; }
    .hm-plan-name { margin: 0; font-family: var(--font-display); font-size: clamp(24px, 2vw, 30px); font-weight: 600; letter-spacing: -0.025em; color: var(--fg); }
    .hm-plan-price { display: grid; margin: 22px 0 0; }
    .hm-swap { grid-area: 1 / 1; transition: opacity 0.3s var(--ease-out), transform 0.4s var(--ease-out), visibility 0s; }
    .hm-plan-price > .hm-swap, .hm-plan--free .hm-plan-price { display: flex; align-items: baseline; gap: 12px; }
    .hm-amt { font-family: var(--font-display); font-size: clamp(52px, 5.4vw, 76px); font-weight: 600; letter-spacing: -0.036em; line-height: 1; color: var(--fg); font-variant-numeric: tabular-nums; }
    .hm-per { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.06em; color: var(--fg-3); }
    .hm-plan-note { display: grid; margin: 14px 0 0; font-size: 14.5px; line-height: 1.5; color: var(--fg-2); max-width: 46ch; }

    .hm-swap--y { opacity: 0; transform: translateY(8px); visibility: hidden; transition: opacity 0.3s var(--ease-out), transform 0.4s var(--ease-out), visibility 0s linear 0.3s; }
