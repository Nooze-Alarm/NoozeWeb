---
// Desktop: scroll-to-top button. Phones (<=760px): a docked Google Play pill instead.
// Visibility of both is toggled by the global script.
import PlayButton from './PlayButton.astro';
---
<button id="backToTop" class="nz-top" type="button" aria-label="Back to top">
    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 13.5V2.5M3.5 7 8 2.5 12.5 7" /></svg>
</button>
<div class="nz-dock" data-dock>
    <PlayButton />
</div>
