const groups = [
    { title: 'Product', links: [['/features.html', 'Features'], ['/roadmap.html', 'Roadmap'], ['/faq.html', 'FAQ']] },
    { title: 'Nooze', links: [['/about.html', 'About'], ['/contact.html', 'Contact'], ['/support.html', 'Support us']] },
    { title: 'Legal', links: [['/privacy.html', 'Privacy policy'], ['/terms.html', 'Terms and conditions'], ['/account-deletion.html', 'Delete your account']] },
];
---
<footer class="nz-footer">
    {!minimal && (
        <div class="nz-container nz-footer-grid">
            <div class="nz-footer-brand">
                <a href="/" class="nz-brand" aria-label="Nooze Alarm home">
                    <img src="/assets/logo-64.webp" srcset="/assets/logo-64.webp 1x, /assets/logo-96.webp 1.5x" alt="" width="30" height="30" loading="lazy" />
                    <span class="nz-lockup">Nooze <span>Alarm</span></span>
                </a>
                <p class="nz-small" style="margin:18px 0 0;max-width:34ch">The no-snooze alarm with wake-up challenges, a smart wake window and friends who keep you honest. Built in Bulgaria by one developer.</p>
                <p class="nz-small" style="margin:14px 0 0"><a class="nz-link" href="mailto:noozealarm@gmail.com">noozealarm@gmail.com</a></p>
                <div class="nz-social">
                    {social.map((s) => (
                        <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={`Nooze on ${s.label}`}>
                            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={s.d} /></svg>
                        </a>
                    ))}
                </div>
            </div>
            {groups.map((g) => (
                <div>
                    <h2>{g.title}</h2>
                    <ul>{g.links.map(([href, label]) => <li><a href={href}>{label}</a></li>)}</ul>
                </div>
            ))}
        </div>
    )}
    <div class="nz-container nz-footer-base">
        <p class="footer-disclaimer">Nooze is not a medical device. Sleep phases, sleep scores, snoring detection and any heart-rate values in the app are estimates for general wellness only and are not medical advice.</p>
        <p>&copy; 2025&ndash;2026 Nooze Alarm</p>
    </div>
</footer>
