---
// Homepage: real app screens. Each image is the screen area cropped out of a Play Store
// screenshot (store caption and phone outline removed), so the captions here are our own.
// Images run off the bottom like the store frames do; the bezel fades out to match.
const shots = [
    { file: '01-challenge', title: 'Solve it to stop it', body: 'No snooze button. A quick sum switches the alarm off.', alt: 'Nooze wake-up screen showing a math challenge, 12 + 37, with an answer field and a Submit button' },
    { file: '02-challenges', title: 'Pick your wake-up challenge', body: 'Choose the challenge and difficulty for each alarm.', alt: 'Add alarm screen with Smart Wake and Sunrise Wake switches and a grid of challenge types: math, memory, shake, typing, QR scan and photo' },
    { file: '03-home', title: 'Your morning at a glance', body: 'Next alarm, streak and last night on one screen.', alt: 'Nooze home screen with a clock face, the next alarm at 9:00 AM, streak and wake ease stats, and last night’s sleep time' },
    { file: '04-alarms', title: 'Every alarm in one place', body: 'Switch them on and off with one tap.', alt: 'Alarm list with alarms at 6:00, 7:00 and 9:00 AM, each with an on or off switch and a difficulty label' },
    { file: '05-sleep', title: 'Track your nights', body: 'Estimates from your phone. Not a medical device.', alt: 'Sleep screen with a sleep tip, shortcuts to sleep aids, journal, sleep analytics and recordings, and a note that Nooze is not a medical device' },
    { file: '06-wind-down', title: 'Wind down for the night', body: 'Guided breathing and sleep sounds before bed.', alt: 'Breathing exercise screen set to the 4-7-8 pattern, with a large circle that reads Hold 6' },
];
---
<section class="nz-section hm-screens" aria-labelledby="screensTitle">
    <div class="nz-container">
        <div class="nz-head nz-head--row nz-reveal">
            <h2 class="nz-h2" id="screensTitle">Straight from the app.</h2>
            <p class="nz-lede hm-screens-lede">Real screens from the version on Google Play today. No mock-ups.</p>
            <div class="nz-head-action hm-rail-nav">
                <button type="button" class="hm-rail-btn" data-rail-prev aria-controls="hmRail" aria-label="Previous screens" aria-disabled="true">
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13.5 8h-11M7 3.5 2.5 8 7 12.5" /></svg>
                </button>
                <button type="button" class="hm-rail-btn" data-rail-next aria-controls="hmRail" aria-label="Next screens">
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 8h11M9 3.5 13.5 8 9 12.5" /></svg>
                </button>
            </div>
        </div>
    </div>

    <div class="hm-rail nz-reveal" id="hmRail" data-rail tabindex="0" role="region" aria-label="App screens, scroll sideways to see more">
        <ul class="hm-track">
            {shots.map((s, i) => (
                <li class="hm-shot" style={`--i:${i}`} data-shot>
                    <figure>
                        <div class="hm-bezel">
                            <img
                                src={`/assets/screens/${s.file}.webp`}
                                srcset={`/assets/screens/${s.file}-400.webp 400w, /assets/screens/${s.file}.webp 640w`}
                                sizes="(max-width: 760px) 70vw, 320px"
                                width="640" height="1093"
                                alt={s.alt}
                                loading="lazy" decoding="async" draggable="false"
                            />
                        </div>
                        <figcaption>
                            <span class="hm-shot-title">{s.title}</span>
                            <span class="hm-shot-body">{s.body}</span>
                        </figcaption>
                    </figure>
                </li>
            ))}
        </ul>
    </div>

    <div class="nz-container">
        <div class="hm-progress" aria-hidden="true"><span data-rail-thumb></span></div>
    </div>
</section>

<style>
    .hm-screens { overflow: hidden; }
    .hm-screens-lede { text-wrap: balance; }
    .hm-rail-nav { display: flex; gap: 10px; }
    .hm-rail-btn {
        display: grid; place-items: center; width: 52px; height: 52px; border-radius: 999px; border: 0; cursor: pointer;
        color: var(--fg); background: rgba(255, 255, 255, 0.02); box-shadow: inset 0 0 0 1px var(--line-2);
        transition: background-color 0.25s var(--ease-out), box-shadow 0.25s var(--ease-out), opacity 0.25s var(--ease-out), transform 0.16s var(--ease-out);
        -webkit-tap-highlight-color: transparent;
    }
    .hm-rail-btn svg { width: 16px; height: 16px; }
    .hm-rail-btn:active { transform: scale(0.95); }
    .hm-rail-btn[aria-disabled='true'] { opacity: 0.35; cursor: default; }
    .hm-rail-btn[aria-disabled='true']:active { transform: none; }
    @media (hover: hover) and (pointer: fine) {
        .hm-rail-btn:not([aria-disabled='true']):hover { background: rgba(255, 255, 255, 0.06); box-shadow: inset 0 0 0 1px var(--line-3); }
    }

    /* The rail starts on the container's left edge and runs off the right of the screen */
    .hm-rail {
        --edge: max(var(--gutter), calc((100% - var(--container)) / 2));
        margin-top: clamp(44px, 5vw, 72px);
        overflow-x: auto; overflow-y: hidden;
        scroll-snap-type: x mandatory; scroll-padding-inline: var(--edge);
        overscroll-behavior-x: contain;
        scrollbar-width: none;
        cursor: grab;
        border-radius: 0; outline-offset: -2px;
    }
    .hm-rail::-webkit-scrollbar { display: none; }
    .hm-rail.is-dragging { scroll-snap-type: none; cursor: grabbing; user-select: none; }
    .hm-track {
        display: flex; gap: clamp(20px, 2.4vw, 36px);
        list-style: none; margin: 0; padding: 0 var(--edge) 4px;
        width: max-content;
    }

    .hm-shot { width: clamp(240px, 23vw, 320px); flex: none; scroll-snap-align: start; }
    .hm-shot figure { margin: 0; }

    /* Same frame as the screens on features.html (20px radius, --line-2 hairline, soft
       shadow). These screens are cut off at the bottom, so the frame fades out there. */
    .hm-bezel {
        position: relative; padding: 0 1px;
        -webkit-mask-image: linear-gradient(180deg, #000 66%, transparent 97%);
        mask-image: linear-gradient(180deg, #000 66%, transparent 97%);
        transition: transform 0.5s var(--ease-out);
    }
    .hm-bezel img {
        display: block; width: 100%; height: auto; margin-top: 1px; -webkit-user-drag: none;
        border-radius: 20px 20px 0 0; background: var(--ink-2);
        box-shadow: 0 0 0 1px var(--line-2), 0 40px 80px -40px rgba(0, 0, 0, 0.9);
    }
    @media (hover: hover) and (pointer: fine) {
        .hm-rail:not(.is-dragging) .hm-shot:hover .hm-bezel { transform: translateY(-6px); }
    }

    .hm-shot figcaption { display: grid; gap: 6px; margin-top: -4px; position: relative; padding-right: 8px; }
    .hm-shot-title { font-family: var(--font-display); font-size: clamp(19px, 1.5vw, 22px); font-weight: 600; letter-spacing: -0.02em; line-height: 1.2; color: var(--fg); }
    .hm-shot-body { font-size: 14.5px; line-height: 1.5; color: var(--fg-2); max-width: 30ch; }

    .hm-progress { position: relative; height: 1px; margin-top: clamp(36px, 4vw, 56px); background: var(--line-2); overflow: hidden; }
    .hm-progress span { position: absolute; left: 0; top: 0; height: 1px; width: 30%; background: var(--fg); transform-origin: left; will-change: transform; }

    /* Entrance: the shots rise in sequence when the rail enters */
    .hm-shot { transition: opacity 0.8s var(--ease-out), transform 1s var(--ease-out); transition-delay: calc(var(--i) * 70ms); }
    :global(html.js) .hm-rail.nz-reveal { opacity: 1; transform: none; }
    :global(html.js) .hm-rail:not(.is-in) .hm-shot { opacity: 0; transform: translateY(32px); }

    @media (max-width: 760px) {
        .hm-rail-nav { display: none; }
        .hm-shot { width: 70vw; max-width: 300px; }
    }
    @media (prefers-reduced-motion: reduce) {
        .hm-shot, .hm-bezel { transition: none; }
        :global(html.js) .hm-rail:not(.is-in) .hm-shot { opacity: 1; transform: none; }
    }
</style>

<script>
    const rail = document.querySelector<HTMLElement>('[data-rail]');
    if (rail) {
        const shots = Array.from(rail.querySelectorAll<HTMLElement>('[data-shot]'));
        const prev = document.querySelector<HTMLButtonElement>('[data-rail-prev]');
        const next = document.querySelector<HTMLButtonElement>('[data-rail-next]');
        const thumb = document.querySelector<HTMLElement>('[data-rail-thumb]');
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const behavior: ScrollBehavior = reduce ? 'auto' : 'smooth';

        const maxScroll = () => rail.scrollWidth - rail.clientWidth;
        const stops = () => shots.map((s) => Math.min(s.offsetLeft - shots[0].offsetLeft, maxScroll()));
        const nearest = (x: number) => {
            const all = stops();
            return all.reduce((best, s, i) => (Math.abs(s - x) < Math.abs(all[best] - x) ? i : best), 0);
        };

        let frame = 0;
        const update = () => {
            frame = 0;
            const max = maxScroll();
            const x = rail.scrollLeft;
            prev?.setAttribute('aria-disabled', String(x <= 2));
            next?.setAttribute('aria-disabled', String(x >= max - 2));
            if (thumb) {
                const f = Math.min(1, rail.clientWidth / rail.scrollWidth);
                thumb.style.width = `${f * 100}%`;
                const p = max > 0 ? x / max : 0;
                thumb.style.transform = `translateX(${p * ((1 - f) / f) * 100}%)`;
            }
        };
        const schedule = () => { if (!frame) frame = requestAnimationFrame(update); };
        rail.addEventListener('scroll', schedule, { passive: true });
        window.addEventListener('resize', schedule);
        update();

        const go = (dir: 1 | -1) => {
            const all = stops();
            const i = nearest(rail.scrollLeft);
            const target = all[Math.max(0, Math.min(all.length - 1, i + dir))];
            rail.scrollTo({ left: target, behavior });
        };
        prev?.addEventListener('click', () => { if (prev.getAttribute('aria-disabled') !== 'true') go(-1); });
        next?.addEventListener('click', () => { if (next.getAttribute('aria-disabled') !== 'true') go(1); });

        // Mouse drag (touch and trackpads scroll natively). Snap is paused while dragging,
        // then the rail settles on the nearest screen, carried a little by the flick.
        let drag: { id: number; x: number; left: number; moved: boolean; lastX: number; lastT: number; v: number } | null = null;
        const endDrag = () => {
            if (!drag) return;
            const wasMoved = drag.moved;
            const v = drag.v;
            drag = null;
            if (!wasMoved) return;
            const all = stops();
            const projected = rail.scrollLeft - v * 180;
            const target = all[nearest(projected)];
            rail.scrollTo({ left: target, behavior });
            let done = false;
            const release = () => { if (done) return; done = true; rail.classList.remove('is-dragging'); };
            rail.addEventListener('scrollend', release, { once: true });
            window.setTimeout(release, 700);
        };
        rail.addEventListener('pointerdown', (e) => {
            if (e.pointerType !== 'mouse' || e.button !== 0) return;
            drag = { id: e.pointerId, x: e.clientX, left: rail.scrollLeft, moved: false, lastX: e.clientX, lastT: performance.now(), v: 0 };
        });
        rail.addEventListener('pointermove', (e) => {
            if (!drag || e.pointerId !== drag.id) return;
            const dx = e.clientX - drag.x;
            if (!drag.moved) {
                if (Math.abs(dx) < 5) return;
                drag.moved = true;
                rail.setPointerCapture(e.pointerId);
                rail.classList.add('is-dragging');
            }
            const now = performance.now();
            const dt = Math.max(1, now - drag.lastT);
            drag.v = 0.8 * ((e.clientX - drag.lastX) / dt) + 0.2 * drag.v;
            drag.lastX = e.clientX;
            drag.lastT = now;
            rail.scrollLeft = drag.left - dx;
        });
        rail.addEventListener('pointerup', endDrag);
        rail.addEventListener('pointercancel', endDrag);
        rail.addEventListener('lostpointercapture', endDrag);
    }
</script>
