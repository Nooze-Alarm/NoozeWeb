---
// Homepage hero. The live Nooze mark (window.NoozeMark from Splash.astro) draws itself or
// receives the splash logo, ticks with the wall clock, then hands over to the 3D mark
// (src/scripts/hero-mark-3d.ts) when the device can afford it.
import PlayButton from './PlayButton.astro';
const ticks = Array.from({ length: 60 }, (_, i) => i);
---
<section class="hx" id="nzHero" aria-labelledby="hxTitle">
    <div class="hx-glow" aria-hidden="true"></div>
    <div class="nz-container hx-wrap">
        <div class="hx-copy">
            <p class="nz-live hx-in"><span class="nz-live-dot" aria-hidden="true"></span>Out now on Google Play</p>
            <h1 class="nz-display hx-title hx-in hx-d1" id="hxTitle">Wake up smarter.</h1>
            <p class="nz-lede hx-lede hx-in hx-d2">
                A no-snooze alarm for people who want to get up. Beat a quick challenge,
                keep your streak, win wake duels.
            </p>
            <div class="nz-btn-group hx-in hx-d3">
                <PlayButton />
                <a class="nz-arrowlink" href="#how">
                    <span>See how a morning goes</span>
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 2.5v11M3.5 9 8 13.5 12.5 9" /></svg>
                </a>
            </div>
            <p class="nz-meta hx-note hx-in hx-d3">Free on Android. No ads. Premium is optional.</p>
        </div>

        <div class="hx-stage">
            <svg class="hx-dial" viewBox="0 0 400 400" aria-hidden="true">
                <circle cx="200" cy="200" r="198" fill="none" stroke="currentColor" stroke-width="0.75" />
                {ticks.map((i) => (
                    <line x1="200" y1={i % 5 === 0 ? 6 : 9} x2="200" y2={i % 5 === 0 ? 20 : 14}
                        stroke="currentColor" stroke-width={i % 5 === 0 ? 1.6 : 0.7}
                        transform={`rotate(${i * 6} 200 200)`} />
                ))}
            </svg>
            <div class="nz-mark-wrap">
                <canvas class="nz-mark" id="nzMark" width="440" height="440" data-splash-target role="img" aria-label="Nooze Alarm logo"></canvas>
                <canvas class="nz-mark3d" id="nzMark3d" aria-hidden="true"></canvas>
                <noscript><img class="nz-mark-fallback" src="/assets/logo.png" alt="" width="240" height="240" /></noscript>
            </div>
        </div>
    </div>
</section>

<style>
    .hx {
        position: relative;
        min-height: min(100svh, 1000px);
        display: flex;
        align-items: center;
        padding: calc(var(--nav-h) + 40px) 0 clamp(56px, 8vw, 96px);
        overflow: hidden;
        isolation: isolate;
        border-bottom: 1px solid var(--line);
    }
    .hx-glow {
        position: absolute; inset: 0; z-index: -1; pointer-events: none;
        background:
            radial-gradient(38% 52% at 74% 50%, rgba(0, 96, 208, 0.16), transparent 70%),
            radial-gradient(70% 60% at 50% 120%, rgba(59, 140, 255, 0.06), transparent 70%);
    }
    .hx-wrap {
        display: grid;
        grid-template-columns: minmax(0, 1.08fr) minmax(0, 1fr);
        align-items: center;
        gap: clamp(32px, 5vw, 80px);
    }
    .hx-title { margin-top: 28px; max-width: 9.5em; }
    .hx-lede { margin-top: 30px; }
    .hx-copy .nz-btn-group { margin-top: 40px; }
    .hx-note { margin: 22px 0 0; }

    .hx-stage {
        position: relative;
        display: grid;
        place-items: center;
        aspect-ratio: 1;
        width: min(100%, 580px);
        justify-self: end;
    }
    .hx-dial {
        position: absolute; inset: 0; width: 100%; height: 100%;
        color: var(--fg); opacity: 0.14; pointer-events: none;
    }
    .nz-mark-wrap { position: relative; width: 78%; aspect-ratio: 1; }
    .nz-mark { display: block; width: 100%; height: 100%; }
    .nz-mark.is-off { opacity: 0 !important; transition: opacity 260ms ease-out; }
    /* The 3D mark bleeds past the 2D one so a tilt or the exploded view never clips. */
    .nz-mark3d {
        position: absolute; inset: -16%; width: 132%; height: 132%;
        opacity: 0; pointer-events: none; transition: opacity 260ms ease-out; touch-action: pan-y;
    }
    .nz-mark3d.is-on { opacity: 1; pointer-events: auto; cursor: pointer; }
    .nz-mark-fallback { position: absolute; inset: 22%; width: 56%; height: 56%; border-radius: 22%; }

    /* Entrance plays from CSS on first paint (the headline is the LCP element);
       the splash pauses it until the logo lifts. */
    .hx-in { animation: hxIn 1s var(--ease-out) backwards; }
    .hx-d1 { animation-delay: 0.08s; }
    .hx-d2 { animation-delay: 0.18s; }
    .hx-d3 { animation-delay: 0.28s; }
    @keyframes hxIn { from { opacity: 0; transform: translateY(22px); } }
    .hx-dial { animation: hxDial 1.6s var(--ease-out) 0.2s backwards; }
    @keyframes hxDial { from { opacity: 0; transform: rotate(-24deg) scale(0.94); } }

    @media (max-width: 960px) {
        .hx { min-height: 0; padding-top: calc(var(--nav-h) + 48px); }
        .hx-glow { background: radial-gradient(70% 34% at 50% 80%, rgba(0, 96, 208, 0.18), transparent 70%); }
        .hx-wrap { grid-template-columns: minmax(0, 1fr); gap: 56px; }
        .hx-stage { justify-self: center; width: min(100%, 420px); }
    }
    @media (max-width: 560px) {
        /* Tighter stack so the logo starts inside the first screen on a phone */
        .hx { padding-top: calc(var(--nav-h) + 28px); }
        .hx-wrap { gap: 20px; }
        .hx-title { font-size: clamp(46px, 13vw, 64px); margin-top: 20px; }
        .hx-lede { margin-top: 20px; }
        .hx-copy .nz-btn-group { margin-top: 28px; flex-direction: column; align-items: flex-start; gap: 10px; }
        .hx-note { margin-top: 14px; }
        .hx-stage { width: min(100%, 320px); }
    }
    @media (prefers-reduced-motion: reduce) {
        .hx-in, .hx-dial { animation: none !important; }
    }
</style>

<script>
    // --- The Nooze mark: the app's own logo code (window.NoozeMark, from Splash.astro) ---
    // Without the splash it draws itself the first time it is on screen. After the splash it
    // takes over from the flying logo. Then the second hand ticks with the wall clock, in step
    // with the countdown's seconds, with the small overshoot of the logo's recoil.
    const markEl = document.getElementById('nzMark') as HTMLCanvasElement | null;
    const NoozeMark = (window as any).NoozeMark;

    if (markEl && NoozeMark) {
        const root = document.documentElement;
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const REST = 211; // the logo's second-hand angle
        const INTRO = 1400;
        const TICK = 170; // ms a tick takes
        const s0 = Math.floor(Date.now() / 1000);
        const tickEase = (x: number) => { const u = Math.min(1, Math.max(0, x)) - 1; return 1 + 2.6 * u * u * u + 1.6 * u * u; };
        const secondAngle = () => {
            const now = Date.now();
            return REST + 6 * (Math.floor(now / 1000) - s0 - 1 + tickEase((now % 1000) / TICK));
        };

        let mark = NoozeMark(markEl);
        let width = markEl.clientWidth;
        let mode: 'wait' | 'intro' | 'tick' | 'still' | 'handoff' = 'wait';
        let introStart = 0;
        let raf = 0;
        let timer = 0;
        let inView = false;

        // --- 3D: loaded once the mark is near the screen, mounted once the 2D mark ticks.
        // It takes over face-on, so the swap is invisible; the 2D canvas stays as fallback.
        const hero = document.getElementById('nzHero') as HTMLElement;
        const nav = navigator as Navigator & { connection?: { saveData?: boolean }; deviceMemory?: number };
        const wants3D = !reduce && !nav.connection?.saveData && !(nav.deviceMemory && nav.deviceMemory < 4);
        const mark3d = document.getElementById('nzMark3d') as HTMLCanvasElement | null;
        let mod3d: Promise<typeof import('../scripts/hero-mark-3d')> | null = null;
        let mounted3d = false;
        const preload3D = () => { if (wants3D && mark3d && !mod3d) mod3d = import('../scripts/hero-mark-3d'); };
        const takeOver3D = () => {
            if (!mod3d || !mark3d || mounted3d) return;
            mounted3d = true;
            mod3d.then((m) => {
                m.mountMark3D(mark3d, {
                    secondAngle,
                    hero,
                    onReady: () => {
                        mark3d.classList.add('is-on');
                        markEl.classList.add('is-off');
                        mode = 'handoff';
                    },
                });
            }).catch(() => { /* keep the 2D mark */ });
        };
        if (wants3D) {
            new IntersectionObserver((entries, io) => {
                if (entries[0].isIntersecting) { preload3D(); io.disconnect(); }
            }, { rootMargin: '300px' }).observe(markEl);
        }

        const paint = () => {
            if (mode === 'tick') mark.drawStatic(secondAngle());
            else if (mode === 'still') mark.drawStatic(REST);
        };
        const frame = (now: number) => {
            raf = 0;
            if (timer) { clearTimeout(timer); timer = 0; }
            if (!inView || document.hidden) return;
            if (mode === 'intro') {
                if (!introStart) introStart = now;
                const f = (now - introStart) / INTRO;
                if (f < 1) { mark.drawIntro(f); raf = requestAnimationFrame(frame); return; }
                mode = 'tick';
            }
            if (mode !== 'tick') return;
            if (!mounted3d) takeOver3D();
            paint();
            const into = Date.now() % 1000;
            if (into < TICK + 20) raf = requestAnimationFrame(frame);
            else timer = window.setTimeout(schedule, 1000 - into);
        };
        function schedule() { if (!raf) raf = requestAnimationFrame(frame); }

        const begin = (fromSplash: boolean) => {
            markEl.style.opacity = '';
            if (reduce) { mode = 'still'; paint(); return; }
            mode = fromSplash ? 'tick' : 'intro';
            if (fromSplash) paint();
            schedule();
        };

        if (root.classList.contains('nz-splash-on')) {
            // The splash logo flies in and lands here; stay hidden until it arrives.
            markEl.style.opacity = '0';
            let landed = false;
            window.addEventListener('nz:splash-land', (e: Event) => {
                if ((e as CustomEvent).detail?.target !== markEl) return;
                landed = true;
                markEl.style.transition = 'opacity 160ms ease-out';
                begin(true);
            });
            window.addEventListener('nz:splash-done', () => { if (!landed) begin(false); }, { once: true });
        } else {
            begin(false);
        }

        new IntersectionObserver((entries) => {
            inView = entries[0].isIntersecting;
            if (inView) schedule();
        }, { threshold: 0.2 }).observe(markEl);
        document.addEventListener('visibilitychange', () => { if (!document.hidden) schedule(); });

        // Redraw at the new size when the layout changes (rotation, resize across breakpoints).
        new ResizeObserver(() => {
            const w = markEl.clientWidth;
            if (Math.abs(w - width) < 1) return;
            width = w;
            mark = NoozeMark(markEl);
            if (mode === 'intro') return; // the running intro repaints itself next frame
            paint();
        }).observe(markEl);
    }
</script>
