---
// Floating island nav. Mobile: full-screen menu with staggered links.
// Open/close, Escape and scroll state are handled in public/js/script.js.
import PlayButton from './PlayButton.astro';
const { active } = Astro.props;
const links = [
    { href: '/features.html', label: 'Features', key: 'features' },
    { href: '/#pricing', label: 'Pricing', key: 'pricing' },
    { href: '/about.html', label: 'About', key: 'about' },
    { href: '/roadmap.html', label: 'Roadmap', key: 'roadmap' },
    { href: '/faq.html', label: 'FAQ', key: 'faq' },
];
const menu = [
    { href: '/', label: 'Home', key: 'home' },
    ...links,
    { href: '/support.html', label: 'Support us', key: 'support' },
    { href: '/contact.html', label: 'Contact', key: 'contact' },
];
const cur = (k) => (k === active ? 'page' : undefined);
---
<header class="nz-nav" data-nav>
    <nav class="nz-nav-bar" aria-label="Main">
        <a href="/" class="nz-brand" aria-label="Nooze Alarm home" aria-current={cur('home')}>
            <img src="/assets/logo-64.webp" srcset="/assets/logo-64.webp 1x, /assets/logo-96.webp 1.5x" alt="" width="30" height="30" />
            <span class="nz-lockup">Nooze <span>Alarm</span></span>
        </a>
        <ul class="nz-nav-links">
            {links.map((l) => <li><a href={l.href} aria-current={cur(l.key)}>{l.label}</a></li>)}
        </ul>
        <div class="nz-nav-end">
            <PlayButton size="sm" label="Get the app" />
            <button class="nz-burger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="nzMenu" data-burger>
                <span></span><span></span>
            </button>
        </div>
    </nav>
</header>
<nav class="nz-menu" id="nzMenu" aria-label="Menu" data-menu>
    <ul>
        {menu.map((l, i) => (
            <li><a href={l.href} aria-current={cur(l.key)} style={`--i:${i}`} tabindex="-1">{l.label}</a></li>
        ))}
    </ul>
    <div class="nz-menu-foot">
        <PlayButton />
        <p class="nz-meta" style="margin-top:18px">Free on Android. <a class="nz-link" href="mailto:noozealarm@gmail.com" tabindex="-1">noozealarm@gmail.com</a></p>
    </div>
</nav>
